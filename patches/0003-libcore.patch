+    static final int r0dump_POINT_DEX_FILE_BEFORE_DEFINE = 38;
+
+    /**
+     * Publish Java gates only after native validation and ownership transfer succeed.
+     * @hide
+     */
+    @SystemApi(client = MODULE_LIBRARIES)
+    public static boolean r0dump_configure(
+            int schema,
+            boolean enabled,
+            String runId,
+            String targetPackage,
+            String targetProcess,
+            String processName,
+            String outputParent,
+            int preparedDirectoryFd,
+            long capturePointMask,
+            long maxRecords,
+            long maxArtifacts,
+            long maxTotalBytes,
+            long maxDexBytes,
+            long bufferPoolBytes,
+            long maxCodeItemBytes,
+            long maxFrozenGenerations,
+            long flushIdleMs,
+            boolean manifestEnabled,
+            boolean manifestIncludeSplits,
+            long manifestMaxComponents,
+            long manifestMaxSplits,
+            long manifestMaxEventsPerSource,
+            long manifestMaxTotalEvents,
+            long manifestMaxXmlDepth,
+            long manifestMaxAttributeLength,
+            boolean walkEnabled,
+            int walkStart,
+            int walkMode,
+            String walkNamespacePrefix,
+            long walkDelayMs,
+            long walkMaxClasses,
+            long walkMaxMethods,
+            boolean forceInvokeEnabled,
+            String forceClass,
+            String forceMethod,
+            String forceMethodDescriptor,
+            long forceMaxCalls) {
+        if (!r0dump_configureNative(
+                schema,
+                enabled,
+                runId,
+                targetPackage,
+                targetProcess,
+                processName,
+                outputParent,
+                preparedDirectoryFd,
+                capturePointMask,
+                maxRecords,
+                maxArtifacts,
+                maxTotalBytes,
+                maxDexBytes,
+                bufferPoolBytes,
+                maxCodeItemBytes,
+                maxFrozenGenerations,
+                flushIdleMs,
+                manifestEnabled,
+                manifestIncludeSplits,
+                manifestMaxComponents,
+                manifestMaxSplits,
+                manifestMaxEventsPerSource,
+                manifestMaxTotalEvents,
+                manifestMaxXmlDepth,
+                manifestMaxAttributeLength,
+                walkEnabled,
+                walkStart,
+                walkMode,
+                walkNamespacePrefix,
+                walkDelayMs,
+                walkMaxClasses,
+                walkMaxMethods,
+                forceInvokeEnabled,
+                forceClass,
+                forceMethod,
+                forceMethodDescriptor,
+                forceMaxCalls)) {
+            return false;
+        }
+        r0dump_capturePointMask = enabled ? capturePointMask : 0L;
+        return true;
+    }
+
+    private static native boolean r0dump_configureNative(
+            int schema,
+            boolean enabled,
+            String runId,
+            String targetPackage,
+            String targetProcess,
+            String processName,
+            String outputParent,
+            int preparedDirectoryFd,
+            long capturePointMask,
+            long maxRecords,
+            long maxArtifacts,
+            long maxTotalBytes,
+            long maxDexBytes,
+            long bufferPoolBytes,
+            long maxCodeItemBytes,
+            long maxFrozenGenerations,
+            long flushIdleMs,
+            boolean manifestEnabled,
+            boolean manifestIncludeSplits,
+            long manifestMaxComponents,
+            long manifestMaxSplits,
+            long manifestMaxEventsPerSource,
+            long manifestMaxTotalEvents,
+            long manifestMaxXmlDepth,
+            long manifestMaxAttributeLength,
+            boolean walkEnabled,
+            int walkStart,
+            int walkMode,
+            String walkNamespacePrefix,
+            long walkDelayMs,
+            long walkMaxClasses,
+            long walkMaxMethods,
+            boolean forceInvokeEnabled,
+            String forceClass,
+            String forceMethod,
+            String forceMethodDescriptor,
+            long forceMaxCalls);
+
+    static boolean r0dump_IsCapturePointActive(int point) {
+        return point >= 0 && point < 43 && (r0dump_capturePointMask & (1L << point)) != 0;
+    }
+
+    /**
+     * Return only this loader's cookies; the Framework walker handles the loader graph.
+     * @hide
+     */
+    @SystemApi(client = MODULE_LIBRARIES)
+    public static Object[] r0dump_GetDexCookies(ClassLoader loader) {
+        return BaseDexClassLoader.r0dump_GetDexCookies(loader);
+    }
+
+    static void r0dump_CaptureRouteLoader(
+            ClassLoader loader, int point, String className, int firstElement) {
+        if (!r0dump_IsCapturePointActive(point)) return;
+        Object[] cookies = BaseDexClassLoader.r0dump_GetDexCookies(loader, firstElement);
+        for (Object cookie : cookies) {
+            if (cookie != null) r0dump_CaptureRouteCookieNative(cookie, point, className);
+        }
+    }
+
+    static void r0dump_CaptureRouteCookie(Object cookie, int point, String className) {
+        if (cookie != null && r0dump_IsCapturePointActive(point)) {
+            r0dump_CaptureRouteCookieNative(cookie, point, className);
+        }
+    }
+
+    private static native void r0dump_CaptureRouteCookieNative(
+            Object cookie, int point, String className);
+
