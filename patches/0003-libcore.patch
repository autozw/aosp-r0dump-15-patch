+            int[] sourceOrdinals, String[] sourceKinds, String[] sourceStatuses,
+            int[] sourceEventCounts, String[] sourceLimitHits, int sourceCount,
+            int parsedSourceCount, int rejectedSourceCount, int xmlEventCount, String limitHit);
+    /** @hide */
+    @SystemApi(client = MODULE_LIBRARIES)
+    public static native boolean r0dump_CompleteWalk(boolean bootstrapCompleted);
+    /** @hide */
+    @SystemApi(client = MODULE_LIBRARIES)
+    public static native boolean r0dump_ServiceFlush();
+}
