+/**
+ * Internal bridge to the process-scoped ART capture runtime. No file I/O or
+ * scheduling belongs here: Framework owns scheduling and ART owns capture state.
+ * @hide
+ */
+@SystemApi(client = MODULE_LIBRARIES)
