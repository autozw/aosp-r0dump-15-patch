+    {r0dump_Point::kDefineClassNativeMatch, "DefineClassNative.match"},
+    {r0dump_Point::kRegisterDexFileReturn, "RegisterDexFile.return"},
+    {r0dump_Point::kDefineClassEntry, "DefineClass.entry"},
+    {r0dump_Point::kDefineClassSuccess, "DefineClass.success"},
+    {r0dump_Point::kLoadMethodReady, "LoadMethod.ready"},
+    {r0dump_Point::kLoadClassEntry, "LoadClass.entry"},
+    {r0dump_Point::kLoadClassSuccess, "LoadClass.success"},
+    {r0dump_Point::kResolveMethodCacheHit, "ResolveMethod.cache_hit"},
+    {r0dump_Point::kResolveMethodLookupSuccess, "ResolveMethod.lookup_success"},
+    {r0dump_Point::kVerifyClassComplete, "VerifyClass.complete"},
+    {r0dump_Point::kClassInitBeforeClinit, "ClassInit.before_clinit"},
+    {r0dump_Point::kClassInitSuccess, "ClassInit.success"},
+    {r0dump_Point::kOatDexFileOpenSuccess, "OatDexFile.open.success"},
+    {r0dump_Point::kVdexLoadComplete, "Vdex.load.complete"},
+    {r0dump_Point::kOatManagerFileComplete, "OatManager.file.complete"},
+    {r0dump_Point::kOatManagerMemoryComplete, "OatManager.memory.complete"},
+    {r0dump_Point::kOatManagerRegisterBeforeLock, "OatManager.register.before_lock"},
+    {r0dump_Point::kImageSpaceDexTracked, "ImageSpace.dex.tracked"},
+    {r0dump_Point::kArtMethodInvokeDispatch, "ArtMethod.invoke.dispatch"},
+    {r0dump_Point::kInterpreterExecuteEntry, "Interpreter.execute.entry"},
+    {r0dump_Point::kJitMethodEntered, "Jit.method_entered"},
+    {r0dump_Point::kJitCompileBegin, "Jit.compile.begin"},
+    {r0dump_Point::kJitCompileEnd, "Jit.compile.end"},
+    {r0dump_Point::kReflectMethodBeforeInvoke, "Reflect.method.before_invoke"},
+    {r0dump_Point::kReflectCtorBeforeInvoke, "Reflect.ctor.before_invoke"},
+    {r0dump_Point::kInstrumentationEnter, "Instrumentation.enter"},
+    {r0dump_Point::kInstrumentationExitValue, "Instrumentation.exit.value"},
+    {r0dump_Point::kInstrumentationExitObject, "Instrumentation.exit.object"},
+    {r0dump_Point::kBdclPathConstructor, "BDCL.path.constructor"},
+    {r0dump_Point::kBdclMemoryConstructor, "BDCL.memory.constructor"},
+    {r0dump_Point::kBdclFindClassSuccess, "BDCL.findClass.success"},
+    {r0dump_Point::kBdclAddDexPathReturn, "BDCL.addDexPath.return"},
+    {r0dump_Point::kDexFileOpenFileReturn, "DexFile.open_file.return"},
+    {r0dump_Point::kDexFileOpenMemoryReturn, "DexFile.open_memory.return"},
+    {r0dump_Point::kDexFileBeforeDefine, "DexFile.before_define"},
+    {r0dump_Point::kWalkCookieDex, "Walk.cookie.dex"},
+    {r0dump_Point::kWalkExecutableMethod, "Walk.executable.method"},
+    {r0dump_Point::kForceInvokeNoExecute, "ForceInvoke.no_execute"},
+    {r0dump_Point::kNterpMethodEntry, "Nterp.method.entry"},
+}};
+
+static_assert(kR0dumpPointDescriptors.size() == kR0dumpPointCount);
+
+}  // namespace
+
+std::string_view r0dump_PointName(r0dump_Point point) {
+  const uint8_t index = r0dump_PointIndex(point);
+  return index < kR0dumpPointDescriptors.size() ? kR0dumpPointDescriptors[index].name
+                                                : std::string_view();
+}
+
+std::optional<r0dump_Point> r0dump_PointFromName(std::string_view name) {
+  for (const r0dump_PointDescriptor& descriptor : kR0dumpPointDescriptors) {
+    if (descriptor.name == name) {
+      return descriptor.point;
+    }
+  }
+  return std::nullopt;
+}
