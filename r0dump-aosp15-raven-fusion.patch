+
+struct r0dump_ActiveFlushState final {
+  size_t active_pending_bytes = 0u;
+  uint64_t last_activity_ns = 0u;
+  bool watermark_latched = false;
+};
+
+struct r0dump_PointOutcomeCounters final {
