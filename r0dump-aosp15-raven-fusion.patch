+r0dump_CaptureResult r0dump_CaptureDex(r0dump_BufferPool& pool,
+                                       r0dump_Staging& staging,
+                                       const r0dump_BorrowedDex& borrowed,
+                                       r0dump_CaptureKind kind,
+                                       const r0dump_HookContext& context,
+                                       std::string_view capture_role) {
+  r0dump_RecursionGuard guard;
+  if (!guard.r0dump_Entered()) {
+    return {.status = r0dump_CaptureStatus::kReentrant};
+  }
+
+  const std::shared_ptr<DexFileContainer>& container = borrowed.dex.GetContainer();
+  if (container == nullptr) {
+    return r0dump_RecordCaptureDrop(
+        staging, context, kind, r0dump_DexFormat::kNotApplicable, "missing_container");
+  }
+  const uint8_t* begin = nullptr;
+  size_t size = 0u;
+  r0dump_DexFormat format = r0dump_DexFormat::kNotApplicable;
+  std::unique_ptr<uint8_t[]> logical_copy;
+  bool logical_copy_complete = true;
+  size_t logical_copy_bytes = 0u;
+  std::string logical_copy_holes;
+  switch (kind) {
+    case r0dump_CaptureKind::kDexView:
+      begin = borrowed.dex.Begin();
+      size = borrowed.dex.Size();
+      format = r0dump_ValidateDexImage(begin, size).value_or(r0dump_DexFormat::kNotApplicable);
+      break;
+    case r0dump_CaptureKind::kDexData:
+      begin = borrowed.dex.DataBegin();
+      size = borrowed.dex.DataSize();
+      if (size == 0u || size > kR0dumpMaxDexBytesHardLimit) {
+        return r0dump_RecordDexDrop(staging, context, kind, format, "invalid_range", borrowed.dex);
+      }
+      logical_copy = r0dump_CopyLogicalData(
+          begin, size, &logical_copy_complete, &logical_copy_bytes, &logical_copy_holes);
+      if (logical_copy == nullptr || logical_copy_bytes == 0u) {
+        return r0dump_RecordDexDrop(staging, context, kind, format, "invalid_range", borrowed.dex);
+      }
+      begin = logical_copy.get();
+      break;
+    case r0dump_CaptureKind::kBuffer:
+    case r0dump_CaptureKind::kCodeItem:
+    case r0dump_CaptureKind::kMetadata:
+      return r0dump_RecordDexDrop(
+          staging, context, kind, format, "capture_kind_mismatch", borrowed.dex);
+  }
+  if (size > kR0dumpMaxDexBytesHardLimit ||
+      (kind == r0dump_CaptureKind::kDexView &&
+       (!r0dump_IsBoundedSpan(
+            begin, size, container->Begin(), container->End() - container->Begin()) ||
+        !r0dump_IsReadableSpan(begin, size))) ||
+      (kind == r0dump_CaptureKind::kDexView && format == r0dump_DexFormat::kNotApplicable)) {
+    return r0dump_RecordDexDrop(staging, context, kind, format, "invalid_range", borrowed.dex);
+  }
+  r0dump_RecordMetadata metadata = r0dump_DexMetadata(borrowed.dex);
+  metadata.class_def_index = borrowed.class_def_index;
+  if (!capture_role.empty()) {
+    metadata.capture_role = std::string(capture_role);
+  }
+  if (logical_copy != nullptr) {
+    r0dump_AnnotateLogicalCopy(&metadata, logical_copy_complete, logical_copy_bytes);
+    if (!metadata.runtime_view_json.empty()) {
+      metadata.runtime_view_json.insert(metadata.runtime_view_json.size() - 1u, logical_copy_holes);
+    }
+  }
+  if (logical_copy != nullptr) {
+    begin = logical_copy.get();
+  }
+  return r0dump_CopyAndSubmitDex(
+      pool, staging, begin, size, kind, format, context, std::move(metadata));
+}
+
+r0dump_CaptureResult r0dump_CaptureBuffer(r0dump_BufferPool& pool,
+                                          r0dump_Staging& staging,
+                                          const r0dump_BorrowedBuffer& borrowed,
+                                          const r0dump_HookContext& context,
+                                          r0dump_RecordMetadata metadata) {
+  r0dump_RecursionGuard guard;
+  if (!guard.r0dump_Entered()) {
+    return {.status = r0dump_CaptureStatus::kReentrant};
+  }
+  const std::optional<r0dump_DexFormat> format =
+      r0dump_ValidateDexImage(borrowed.begin, borrowed.size);
+  metadata.declared_size = borrowed.size;
+  metadata.container_size = borrowed.container_size;
+  if (borrowed.size > kR0dumpMaxDexBytesHardLimit || !format.has_value() ||
+      !r0dump_IsBoundedSpan(
+          borrowed.begin, borrowed.size, borrowed.container_begin, borrowed.container_size)) {
+    return {
+        .status = r0dump_CaptureStatus::kInvalidRange,
+        .submit = staging.r0dump_RecordDrop(context,
+                                            r0dump_CaptureKind::kBuffer,
+                                            format.value_or(r0dump_DexFormat::kNotApplicable),
+                                            "invalid_range",
+                                            std::move(metadata)),
+    };
+  }
+  return r0dump_CopyAndSubmitDex(pool,
+                                 staging,
+                                 borrowed.begin,
+                                 borrowed.size,
+                                 r0dump_CaptureKind::kBuffer,
+                                 *format,
+                                 context,
+                                 std::move(metadata));
+}
+
+r0dump_CaptureResult r0dump_CaptureCodeItem(r0dump_BufferPool& pool,
+                                            r0dump_Staging& staging,
+                                            const DexFile& dex_file,
+                                            const dex::CodeItem* code_item,
+                                            r0dump_CodeItemKey key,
+                                            r0dump_CodeItemMetadata metadata,
+                                            const r0dump_HookContext& context) {
+  r0dump_RecursionGuard guard;
+  if (!guard.r0dump_Entered()) {
+    return {.status = r0dump_CaptureStatus::kReentrant};
+  }
+  const uint8_t* begin = nullptr;
+  size_t size = 0u;
+  uint32_t actual_offset = 0u;
+  if (!r0dump_GetCodeItemSpan(
+          dex_file, code_item, pool.r0dump_MaxCodeItemBytes(), &begin, &size, &actual_offset)) {
+    return r0dump_RecordCaptureDrop(staging,
+                                    context,
+                                    r0dump_CaptureKind::kCodeItem,
+                                    r0dump_DexFormat::kNotApplicable,
+                                    "invalid_range");
+  }
+  if (key.code_offset != actual_offset) {
+    return r0dump_RecordCaptureDrop(staging,
+                                    context,
+                                    r0dump_CaptureKind::kCodeItem,
+                                    r0dump_DexFormat::kNotApplicable,
+                                    "code_offset_mismatch");
+  }
+  std::unique_ptr<r0dump_OwnedCapture> capture = pool.r0dump_TryAcquire(begin, size);
+  if (capture == nullptr) {
+    return r0dump_RecordCaptureDrop(staging,
+                                    context,
+                                    r0dump_CaptureKind::kCodeItem,
+                                    r0dump_DexFormat::kNotApplicable,
+                                    "pool_unavailable",
+                                    r0dump_CaptureStatus::kPoolUnavailable);
+  }
+  return r0dump_SubmitCapturedCodeItem(
+      staging, std::move(key), std::move(capture), std::move(metadata), context);
+}
+
+r0dump_CaptureStatus r0dump_PrepareCodeItem(r0dump_BufferPool& pool,
+                                            const DexFile& dex_file,
+                                            const dex::CodeItem* code_item,
+                                            uint32_t method_index,
+                                            std::optional<uint32_t> class_def_index,
+                                            r0dump_CodeItemRole role,
+                                            bool class_initialized,
+                                            bool no_execute,
+                                            const r0dump_HookContext& context,
+                                            r0dump_PreparedCodeItem* prepared) {
+  r0dump_RecursionGuard guard;
+  if (!guard.r0dump_Entered()) {
+    return r0dump_CaptureStatus::kReentrant;
+  }
+  if (prepared == nullptr || prepared->capture.r0dump_IsReady()) {
+    return r0dump_CaptureStatus::kInvalidRange;
+  }
+  const uint8_t* begin = nullptr;
+  size_t size = 0u;
+  uint32_t code_offset = 0u;
+  if (!r0dump_GetCodeItemSpan(
+          dex_file, code_item, pool.r0dump_MaxCodeItemBytes(), &begin, &size, &code_offset)) {
+    return r0dump_CaptureStatus::kInvalidRange;
+  }
+  if (!pool.r0dump_TryPrepareCodeItem(begin, size, &prepared->capture)) {
+    return r0dump_CaptureStatus::kPoolUnavailable;
+  }
+  prepared->context = context;
+  prepared->dex_identity = r0dump_DexIdentity(dex_file);
+  prepared->dex_size = dex_file.Size();
+  prepared->method_index = method_index;
+  prepared->code_offset = code_offset;
+  prepared->class_def_index = class_def_index;
+  prepared->role = role;
+  prepared->class_initialized = class_initialized;
+  prepared->no_execute = no_execute;
+  return r0dump_CaptureStatus::kSubmitted;
+}
+
+r0dump_CaptureResult r0dump_SubmitPreparedCodeItem(r0dump_Staging& staging,
+                                                   r0dump_PreparedCodeItem&& prepared) {
+  r0dump_RecursionGuard guard;
+  if (!guard.r0dump_Entered()) {
+    return {.status = r0dump_CaptureStatus::kReentrant};
+  }
+  std::unique_ptr<r0dump_OwnedCapture> capture = prepared.capture.r0dump_Consume();
+  if (capture == nullptr) {
+    return {.status = r0dump_CaptureStatus::kPoolUnavailable};
+  }
+  r0dump_CodeItemKey key = {
+      .dex_hash = prepared.dex_identity,
+      .dex_size = prepared.dex_size,
+      .method_index = prepared.method_index,
+      .code_offset = prepared.code_offset,
+      .attempt_id = prepared.attempt_id,
+      .role = std::string(r0dump_CodeItemRoleName(prepared.role)),
+  };
+  r0dump_CodeItemMetadata metadata = {
+      .class_name = std::move(prepared.class_name),
+      .method_name = std::move(prepared.method_name),
+      .descriptor = std::move(prepared.method_descriptor),
+      .class_initialized = prepared.class_initialized,
+      .no_execute = prepared.no_execute,
+  };
+  r0dump_RecordMetadata record_metadata = {
+      .source_kind = std::move(prepared.source_kind),
+      .class_def_index = prepared.class_def_index,
+      .entry_kind = std::move(prepared.entry_kind),
+      .access_flags = prepared.access_flags,
+      .nterp_entry_fast_path = prepared.nterp_entry_fast_path,
+      .nterp_invoke_fast_path = prepared.nterp_invoke_fast_path,
+      .code_item_present = prepared.code_item_present,
+      .observation_phase = std::move(prepared.observation_phase),
+  };
+  record_metadata.dex_object_id = prepared.dex_identity;
+  record_metadata.declared_size = prepared.dex_size;
+  record_metadata.method_index = prepared.method_index;
+  record_metadata.code_item_offset = prepared.code_offset;
+  record_metadata.code_item_size = capture->r0dump_Size();
+  return {
+      .status = r0dump_CaptureStatus::kSubmitted,
+      .submit = staging.r0dump_SubmitCodeItem(std::move(key),
+                                              std::move(capture),
+                                              std::move(metadata),
+                                              prepared.context,
+                                              std::move(record_metadata)),
+  };
+}
