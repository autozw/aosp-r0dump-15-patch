+
+#include "r0dump/r0dump_config.h"
+
+#include <gtest/gtest.h>
+#include <unistd.h>
+
+#include "r0dump/r0dump_hook_point.h"
+
+namespace art HIDDEN {
+namespace {
+
+constexpr uid_t kR0dumpAndroidUserOffset = 100000u;
+
+std::string r0dump_OutputParent(std::string_view package_name) {
+  return "/storage/emulated/" + std::to_string(getuid() / kR0dumpAndroidUserOffset) +
+         "/Android/data/" + std::string(package_name) + "/files";
+}
+
+r0dump_ProcessConfig r0dump_ValidConfig() {
+  r0dump_ProcessConfig config;
+  config.enabled = true;
+  config.run_id = "20260824T120000Z-a1b2c3d4";
+  config.target_package = "com.example.target";
+  config.target_process = "com.example.target";
+  config.process_name = "com.example.target";
+  config.output_parent = r0dump_OutputParent(config.target_package);
+  config.capture_point_mask = r0dump_PointBit(r0dump_Point::kCookieResultDex);
+  return config;
+}
+
+TEST(r0dump_ConfigTest, AcceptsCanonicalConfig) {
+  r0dump_ConfigError error;
+  EXPECT_TRUE(r0dump_ValidateConfig(r0dump_ValidConfig(), &error));
+  EXPECT_EQ(error.code, r0dump_ConfigErrorCode::kNone);
+  EXPECT_EQ(error.field, nullptr);
+}
+
+TEST(r0dump_ConfigTest, RejectsUndefinedCapturePointBit) {
+  r0dump_ProcessConfig config = r0dump_ValidConfig();
+  config.capture_point_mask |= uint64_t{1} << 43u;
+  r0dump_ConfigError error;
+  EXPECT_FALSE(r0dump_ValidateConfig(config, &error));
+  EXPECT_EQ(error.code, r0dump_ConfigErrorCode::kInvalidCapturePointMask);
+}
+
+TEST(r0dump_ConfigTest, ForceInvokeRequiresNoExecutePointAndBoundedScope) {
+  r0dump_ProcessConfig config = r0dump_ValidConfig();
+  config.force_invoke_enabled = true;
+  config.force_class = "com.example.target.Entry";
+  config.force_method = "materialize";
+  config.force_method_descriptor = "()V";
+
+  r0dump_ConfigError error;
+  EXPECT_FALSE(r0dump_ValidateConfig(config, &error));
+  EXPECT_EQ(error.code, r0dump_ConfigErrorCode::kInvalidForceSelector);
+
+  config.capture_point_mask |= r0dump_PointBit(r0dump_Point::kForceInvokeNoExecute);
+  EXPECT_TRUE(r0dump_ValidateConfig(config, &error));
+
+  config.force_method_descriptor = "";
+  EXPECT_FALSE(r0dump_ValidateConfig(config, &error));
+
+  config.force_method_descriptor = "(Ljava.lang.String;)V";
+  EXPECT_FALSE(r0dump_ValidateConfig(config, &error));
+
+  config.force_method_descriptor = "([Ljava/lang/String;I)Ljava/lang/Object;";
+  EXPECT_TRUE(r0dump_ValidateConfig(config, &error));
+
+  config.force_class.clear();
+  config.force_method.clear();
+  config.force_method_descriptor.clear();
+  config.manifest_enabled = true;
+  EXPECT_TRUE(r0dump_ValidateConfig(config, &error));
+
+  config.manifest_enabled = false;
+  EXPECT_FALSE(r0dump_ValidateConfig(config, &error));
+
+  config.manifest_enabled = true;
+  config.force_class = "com.example.target.Entry";
+  EXPECT_FALSE(r0dump_ValidateConfig(config, &error));
+}
+
+TEST(r0dump_ConfigTest, RejectsPathLikeIdentityFields) {
+  r0dump_ProcessConfig config = r0dump_ValidConfig();
+  config.run_id = "../escape";
+  EXPECT_FALSE(r0dump_ValidateConfig(config, nullptr));
+
+  config = r0dump_ValidConfig();
+  config.target_process = "com.other.process";
+  EXPECT_FALSE(r0dump_ValidateConfig(config, nullptr));
+
+  config = r0dump_ValidConfig();
+  config.target_process = "com.example.target:child";
+  config.process_name = "com.example.target:child";
+  EXPECT_TRUE(r0dump_ValidateConfig(config, nullptr));
+}
+
+TEST(r0dump_ConfigTest, NamespacePrefixIsExplicitAndSegmentBounded) {
+  r0dump_ProcessConfig config = r0dump_ValidConfig();
+  config.walk_namespace_prefix = "com.example.ui.";
+  EXPECT_TRUE(r0dump_ValidateConfig(config, nullptr));
+
+  config.walk_namespace_prefix = "com.example.ui";
+  r0dump_ConfigError error;
+  EXPECT_FALSE(r0dump_ValidateConfig(config, &error));
+  EXPECT_EQ(error.code, r0dump_ConfigErrorCode::kInvalidWalkSelector);
+  EXPECT_STREQ(error.field, "walk_namespace_prefix");
+}
+
+TEST(r0dump_ConfigTest, AcceptsOnlyCanonicalOutputParent) {
+  r0dump_ProcessConfig config = r0dump_ValidConfig();
+  config.output_parent = r0dump_OutputParent("com.other.target");
+  r0dump_ConfigError error;
+  EXPECT_FALSE(r0dump_ValidateConfig(config, &error));
+  EXPECT_EQ(error.code, r0dump_ConfigErrorCode::kInvalidOutputParent);
+
+  config.output_parent += "/../escape";
+  EXPECT_FALSE(r0dump_ValidateConfig(config, nullptr));
+
+  config.output_parent = "/data/user/0/com.example.target/files";
+  EXPECT_FALSE(r0dump_ValidateConfig(config, nullptr));
+
+  config.output_parent = "/sdcard/Android/data/com.example.target/files";
+  EXPECT_FALSE(r0dump_ValidateConfig(config, nullptr));
+}
+
+TEST(r0dump_ConfigTest, RejectsBudgetsOutsideDocumentedHardLimits) {
+  r0dump_ProcessConfig config = r0dump_ValidConfig();
+  config.max_total_bytes = kR0dumpMaxTotalBytesHardLimit;
+  config.max_dex_bytes = kR0dumpMaxDexBytesHardLimit;
+  config.buffer_pool_bytes = kR0dumpBufferPoolBytesHardLimit;
+  config.max_code_item_bytes = kR0dumpMaxCodeItemBytesHardLimit;
+  EXPECT_TRUE(r0dump_ValidateConfig(config, nullptr));
+
+  config = r0dump_ValidConfig();
+  config.max_total_bytes = kR0dumpMaxTotalBytesHardLimit + 1u;
+  EXPECT_FALSE(r0dump_ValidateConfig(config, nullptr));
+
+  config = r0dump_ValidConfig();
+  config.max_total_bytes = kR0dumpMaxDexBytesHardLimit;
+  config.max_dex_bytes = kR0dumpMaxDexBytesHardLimit;
+  config.buffer_pool_bytes = kR0dumpMaxDexBytesHardLimit;
+  EXPECT_TRUE(r0dump_ValidateConfig(config, nullptr));
+
+  config.max_total_bytes = kR0dumpMaxDexBytesHardLimit + 1u;
+  config.max_dex_bytes = kR0dumpMaxDexBytesHardLimit + 1u;
+  EXPECT_FALSE(r0dump_ValidateConfig(config, nullptr));
+
+  config = r0dump_ValidConfig();
+  config.max_dex_bytes = config.max_total_bytes + 1u;
+  EXPECT_FALSE(r0dump_ValidateConfig(config, nullptr));
+
+  config = r0dump_ValidConfig();
+  config.max_artifacts = config.max_records + 1u;
+  EXPECT_FALSE(r0dump_ValidateConfig(config, nullptr));
+}
+
+TEST(r0dump_ConfigTest, RejectsConfigurableBufferAndManifestLimitsOutsideCeilings) {
+  r0dump_ProcessConfig config = r0dump_ValidConfig();
+  config.buffer_pool_bytes = config.max_dex_bytes - 1u;
+  EXPECT_FALSE(r0dump_ValidateConfig(config, nullptr));
+
+  config = r0dump_ValidConfig();
+  config.max_code_item_bytes = kR0dumpMaxCodeItemBytesHardLimit + 1u;
+  EXPECT_FALSE(r0dump_ValidateConfig(config, nullptr));
+
+  config = r0dump_ValidConfig();
+  config.max_frozen_generations = kR0dumpMaxFrozenGenerationsHardLimit + 1u;
+  EXPECT_FALSE(r0dump_ValidateConfig(config, nullptr));
+
+  config = r0dump_ValidConfig();
+  config.flush_idle_ms = kR0dumpFlushIdleMsHardLimit + 1u;
+  EXPECT_FALSE(r0dump_ValidateConfig(config, nullptr));
+
+  config = r0dump_ValidConfig();
+  config.manifest_max_splits = kR0dumpManifestSplitsHardLimit + 1u;
+  EXPECT_FALSE(r0dump_ValidateConfig(config, nullptr));
+
+  config = r0dump_ValidConfig();
+  config.manifest_max_total_events = config.manifest_max_events_per_source - 1u;
+  EXPECT_FALSE(r0dump_ValidateConfig(config, nullptr));
+
+  config = r0dump_ValidConfig();
+  config.walk_max_methods = kR0dumpWalkMethodsHardLimit + 1u;
+  EXPECT_FALSE(r0dump_ValidateConfig(config, nullptr));
+}
+
+TEST(r0dump_ConfigTest, RejectsUnknownWalkSelectors) {
+  r0dump_ProcessConfig config = r0dump_ValidConfig();
+  config.walk_start = static_cast<r0dump_WalkStart>(2u);
+  r0dump_ConfigError error;
+  EXPECT_FALSE(r0dump_ValidateConfig(config, &error));
+  EXPECT_EQ(error.code, r0dump_ConfigErrorCode::kInvalidWalkSelector);
+
+  config = r0dump_ValidConfig();
+  config.walk_mode = static_cast<r0dump_WalkMode>(2u);
+  EXPECT_FALSE(r0dump_ValidateConfig(config, nullptr));
+}
+
+TEST(r0dump_ConfigTest, PublishesOneImmutableSnapshot) {
+  r0dump_ConfigStore store;
+  r0dump_ConfigError error;
+  EXPECT_TRUE(store.r0dump_ConfigureOnce(r0dump_ValidConfig(), &error));
+  ASSERT_NE(store.r0dump_Get(), nullptr);
+  EXPECT_TRUE(store.r0dump_IsEnabledFor("com.example.target", "com.example.target"));
+  EXPECT_FALSE(store.r0dump_IsEnabledFor("com.example.other", "com.example.other"));
+
+  r0dump_ProcessConfig replacement = r0dump_ValidConfig();
+  replacement.run_id = "replacement";
+  EXPECT_FALSE(store.r0dump_ConfigureOnce(std::move(replacement), &error));
+  EXPECT_EQ(error.code, r0dump_ConfigErrorCode::kAlreadyConfigured);
+  EXPECT_EQ(store.r0dump_Get()->run_id, "20260824T120000Z-a1b2c3d4");
+}
+
+TEST(r0dump_ConfigTest, EmptyTargetProcessMatchesAllPackageProcesses) {
+  r0dump_ProcessConfig config = r0dump_ValidConfig();
+  config.target_process.clear();
+  config.process_name = "com.example.target:child";
+  r0dump_ConfigStore store;
+  ASSERT_TRUE(store.r0dump_ConfigureOnce(std::move(config), nullptr));
+  EXPECT_TRUE(store.r0dump_IsEnabledFor("com.example.target", "com.example.target"));
+  EXPECT_TRUE(store.r0dump_IsEnabledFor("com.example.target", "com.example.target:child"));
+}
+
+}  // namespace
+}  // namespace art HIDDEN
diff --git a/art/runtime/r0dump/r0dump_f2_canonical_output_source_test.py b/art/runtime/r0dump/r0dump_f2_canonical_output_source_test.py
new file mode 100644
--- /dev/null
+++ b/art/runtime/r0dump/r0dump_f2_canonical_output_source_test.py
@@ -0,0 +1,118 @@
+#!/ usr / bin / env python3
+
+from pathlib import Path
+
+
+ROOT = Path(__file__).resolve().parents[3]
+
+
+def r0dump_read(path: str) -> str:
+    return (ROOT / path).read_text(encoding="utf-8")
+
+
+def r0dump_assert_order(text: str, first: str, second: str) -> None:
+    assert text.index(first) < text.index(second), f"expected {first!r} before {second!r}"
+
+
+def r0dump_test_file_module_owns_all_canonical_outputs() -> None:
+    source = r0dump_read("art/runtime/r0dump/r0dump_file.cc")
+    for name in (
+        '"session.json"',
+        '"manifest.json"',
+        '"methods.jsonl"',
+        '"summary.json"',
+    ):
+        assert name in source
+    r0dump_assert_order(source, "r0dump_EnsureRunOpenLocked", "r0dump_WriteFrozenGeneration")
+    assert "methods_jsonl.append(json)" in source
+    assert "record->capture_kind == r0dump_CaptureKind::kCodeItem" in source
+    assert "std::unordered_map" not in r0dump_read("art/runtime/r0dump/r0dump_file.h")
+
+
+def r0dump_test_session_is_truthful_and_complete() -> None:
+    source = r0dump_read("art/runtime/r0dump/r0dump_file.cc")
+    for field in (
+        '"build_fingerprint"',
+        '"art_build_id"',
+        '"art_apex_versions"',
+        '"capture_point_mask"',
+        '"start_monotonic_ns"',
+        '"manifest_status"',
+        '"bootstrap_inventory_status"',
+    ):
+        assert field in source
+    assert '\\"config\\"' in source
+    assert 'r0dump_AppendJsonField(&json, "art_build_id", {}, &first)' in source
+    assert "Runtime::GetVersion" not in source
+
+
+def r0dump_test_summary_uses_fixed_existing_state() -> None:
+    buffer_header = r0dump_read("art/runtime/r0dump/r0dump_buffer.h")
+    file_header = r0dump_read("art/runtime/r0dump/r0dump_file.h")
+    for field in (
+        "pool_high_water_bytes",
+        "pending_entries_high_water",
+        "pending_bytes_high_water",
+        "frozen_generations_high_water",
+        "point_outcomes",
+    ):
+        assert field in buffer_header
+    assert "std::array<uint64_t, 5u> artifact_bytes_" in file_header
+    assert "methods_jsonl_" in file_header
+
+
+def r0dump_test_manifest_helper_has_no_file_io() -> None:
+    helper = r0dump_read(
+        "frameworks/base/core/java/android/app/r0dump_ManifestHelper.java"
+    )
+    worker = r0dump_read(
+        "frameworks/base/core/java/android/app/r0dump_ClassLoaderWalk.java"
+    )
+    for forbidden in ("java.io.File", "FileOutputStream", "Files.write"):
+        assert forbidden not in helper
+    assert "r0dump_PublishManifestSnapshot" in worker
+    assert "snapshot.limitHit" in worker
+
+
+def r0dump_test_worker_owns_capture_lifecycle_logging() -> None:
+    source = r0dump_read("art/runtime/r0dump/r0dump_file.cc")
+    for event in (
+        '"hook_seen"',
+        '"hook_dropped"',
+        '"capture_staged"',
+        '"capture_flushed"',
+        '"capture_duplicate"',
+        '"budget_exhausted"',
+        '"run_degraded"',
+        '"run_completed"',
+    ):
+        assert event in source
+    for field in (
+        '"object_kind"',
+        '"object"',
+        '"dex_format"',
+        '"checksum"',
+        '"source_in_memory"',
+        '"code_item_offset"',
+        '"artifact_id"',
+    ):
+        assert field in source
+    for hook in (
+        "art/runtime/art_method.cc",
+        "art/runtime/class_linker.cc",
+        "art/runtime/instrumentation.cc",
+        "art/runtime/interpreter/interpreter.cc",
+        "art/runtime/jit/jit.cc",
+        "art/runtime/oat/oat_file.cc",
+        "art/runtime/oat/oat_file_assistant.cc",
+        "art/runtime/oat/oat_file_manager.cc",
+    ):
+        assert "r0dump_Log(" not in r0dump_read(hook)
+
+
+if __name__ == "__main__":
+    r0dump_test_file_module_owns_all_canonical_outputs()
+    r0dump_test_session_is_truthful_and_complete()
