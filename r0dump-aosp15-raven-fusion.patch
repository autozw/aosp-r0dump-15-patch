+  // the writer.
+  std::optional<uint64_t> begin;
+  std::optional<uint64_t> data_begin;
+  // Serialized only when ART can prove all section spans are within the
+  // captured logical image. The host rehydrator treats this as an opaque
+  // provenance object, never as permission to read live addresses.
+  std::string runtime_view_json;
+};
+
+struct r0dump_PendingRecord final {
+  uint64_t sequence = 0;
+  r0dump_Point point = r0dump_Point::kCookieResultDex;
+  std::string site;
