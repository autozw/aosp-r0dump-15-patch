+    )
+
+    assert "std::atomic<uint64_t> g_r0dump_jit_compile_attempt_id" in source
+    assert "fetch_add(1u, std::memory_order_relaxed) + 1u" in scope
+    assert "r0dump_Point::kJitCompileBegin" in scope
+    assert "r0dump_Point::kJitCompileEnd" in scope
+    assert "r0dump_ObserveMethodCodeItem" in scope
+    assert "r0dump_ObserveMethodMetadata" in scope
+    assert "r0dump_CodeItemRole::kJitCompile" in scope
+    assert "active_attempt_id" in scope
+    assert "jit_compile" in scope
+    r0dump_assert_no_io(scope)
+
+
+def r0dump_check_all_returns() -> None:
+    source = r0dump_read("runtime/jit/jit.cc")
+    body = r0dump_between(
+        source,
+        "bool Jit::CompileMethodInternal(",
+        "void Jit::WaitForWorkersToBeCreated",
+    )
+    attempt = "r0dump_JitCompileAttempt r0dump_attempt(method);"
+    assert body.count(attempt) == 1
+    assert body.index(attempt) < body.index("jit_compiler_->IsBaselineCompiler()")
+    assert body.count("return r0dump_attempt.r0dump_Return(false);") == 6
+    assert body.count("return r0dump_attempt.r0dump_Return(true);") == 1
+    assert body.count("return r0dump_attempt.r0dump_Return(success);") == 1
+    assert "return false;" not in body
+    assert "return true;" not in body
+    assert "return success;" not in body
+    assert body.index("code_cache_->DoneCompiling") < body.index(
+        "return r0dump_attempt.r0dump_Return(success);"
