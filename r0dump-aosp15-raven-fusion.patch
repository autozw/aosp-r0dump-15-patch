+  EXPECT_EQ(staging->r0dump_RecordCount(), 11u);
+
+  r0dump_FreezeResult frozen = staging->r0dump_TryFreeze();
+  ASSERT_EQ(frozen.status, r0dump_FreezeStatus::kFrozen);
+  ASSERT_EQ(frozen.generation->records->size(), 11u);
+  EXPECT_EQ(frozen.generation->records->at(0u).point, r0dump_Point::kOpenCommonReturn);
+  EXPECT_EQ(frozen.generation->records->at(0u).site, "OpenCommon.return");
+  EXPECT_EQ(frozen.generation->records->at(1u).status, r0dump_RecordStatus::kDuplicate);
+  EXPECT_EQ(frozen.generation->records->at(2u).metadata.method_index, 9u);
+  const r0dump_PendingRecord& source = frozen.generation->records->at(3u);
+  EXPECT_EQ(source.point, r0dump_Point::kVdexLoadComplete);
+  EXPECT_EQ(source.status, r0dump_RecordStatus::kDuplicate);
+  EXPECT_EQ(source.metadata.source_kind, "vdex");
+  EXPECT_EQ(source.metadata.source_count, 1u);
+  EXPECT_EQ(frozen.generation->records->at(4u).point, r0dump_Point::kReflectMethodBeforeInvoke);
+  EXPECT_EQ(frozen.generation->records->at(4u).metadata.capture_role, "reflect_method");
+  EXPECT_EQ(frozen.generation->records->at(8u).point, r0dump_Point::kInstrumentationExitObject);
+  EXPECT_EQ(frozen.generation->records->at(8u).metadata.capture_role, "exit_object");
+  EXPECT_EQ(frozen.generation->records->at(9u).point, r0dump_Point::kBdclFindClassSuccess);
+  EXPECT_EQ(frozen.generation->records->at(9u).status, r0dump_RecordStatus::kDuplicate);
+  EXPECT_EQ(frozen.generation->records->at(9u).payload_id,
+            frozen.generation->records->front().payload_id);
+  EXPECT_EQ(frozen.generation->records->at(10u).point, r0dump_Point::kDexFileBeforeDefine);
+  EXPECT_EQ(frozen.generation->records->at(10u).capture_kind, r0dump_CaptureKind::kMetadata);
+  EXPECT_EQ(frozen.generation->records->at(10u).payload_id, 0u);
+}
