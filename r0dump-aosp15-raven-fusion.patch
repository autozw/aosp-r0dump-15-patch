+
+/**
+ * Process-local, immutable r0dump configuration parsed during application bind.
+ *
+ * @hide
+ */
+public final class r0dump_FusionConfig {
+  static final int MAX_JSON_BYTES = 8192;
+  static final int WALK_START_AFTER_APPLICATION_ON_CREATE = 0;
+  static final int WALK_START_AFTER_FIRST_ACTIVITY_ON_CREATE = 1;
+  static final int WALK_MODE_LOADED_ONLY = 0;
+  static final int WALK_MODE_DEX_NAMES = 1;
+
+  private static final String TAG = "R0dumpFusion";
+  static final String PROPERTY_PREFIX = "persist.sys.r0dump.fusion.";
+  private static final String PROPERTY_GENERATION = PROPERTY_PREFIX + "generation";
+  private static final long DEFINED_CAPTURE_POINT_MASK = (1L << 43) - 1L;
+  private static final long FORCE_INVOKE_NO_EXECUTE_BIT = 1L << 41;
+  private static final long MAX_UNSIGNED_INT = 0xffff_ffffL;
+  private static final r0dump_PropertyAccess SYSTEM_PROPERTIES =
+      new r0dump_PropertyAccess() {
+        @Override
+        public String r0dump_get(String key, String defaultValue) {
