+using r0dump_PendingCodeItemMap = std::
+    unordered_map<r0dump_CodeItemKey, std::vector<r0dump_PendingCodeItem>, r0dump_CodeItemKeyHash>;
+
+enum class r0dump_SubmitStatus : uint8_t {
+  kAccepted,
+  kDuplicate,
+  kLockBusy,
+  kEntryLimit,
+  kRecordLimit,
+  kArtifactLimit,
+  kTotalBytesLimit,
+  kInvalid,
+};
+
+struct r0dump_SubmitResult final {
+  r0dump_SubmitStatus status = r0dump_SubmitStatus::kInvalid;
+  uint64_t sequence = 0;
