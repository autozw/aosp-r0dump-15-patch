+  std::unique_ptr<r0dump_OwnedCapture> capture;
+  r0dump_ObservationSummary observation;
+};
+
+using r0dump_PendingDexMap =
+    std::unordered_map<r0dump_DexBlobKey, std::vector<r0dump_PendingDex>, r0dump_DexBlobKeyHash>;
+
+struct r0dump_CodeItemKey final {
+  uint64_t dex_hash = 0;
+  size_t dex_size = 0;
+  uint32_t method_index = 0;
+  uint32_t code_offset = 0;
+  uint64_t attempt_id = 0;
+  std::string role;
+  size_t code_size = 0;
+  uint64_t code_hash = 0;
+
+  bool operator==(const r0dump_CodeItemKey& other) const;
+};
+
+struct r0dump_CodeItemKeyHash final {
+  size_t operator()(const r0dump_CodeItemKey& key) const;
+};
+
+struct r0dump_CodeItemMetadata final {
+  std::string class_name;
+  std::string method_name;
+  std::string descriptor;
