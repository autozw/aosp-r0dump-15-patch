+r0dump_CaptureStatus r0dump_TryPrepareCodeItem(r0dump_Point point,
+                                               std::string_view site,
+                                               const DexFile& dex_file,
+                                               const dex::CodeItem* code_item,
+                                               uint32_t method_index,
+                                               std::optional<uint32_t> class_def_index,
+                                               r0dump_CodeItemRole role,
+                                               bool class_initialized,
+                                               bool no_execute,
+                                               r0dump_PreparedCodeItem* prepared) {
+  if (!r0dump_IsCapturePointActive(point)) {
+    return r0dump_CaptureStatus::kDisabled;
+  }
+  r0dump_CaptureProcessState* state =
+      g_r0dump_capture_process_state.load(std::memory_order_acquire);
+  DCHECK(state != nullptr);
+  r0dump_CountPointObservation(state, point);
+  return r0dump_PrepareCodeItem(*state->pool,
+                                dex_file,
+                                code_item,
+                                method_index,
+                                class_def_index,
+                                role,
+                                class_initialized,
+                                no_execute,
+                                r0dump_MakeHookContext(point, site),
+                                prepared);
+}
+
+r0dump_CaptureResult r0dump_SubmitPreparedCodeItem(r0dump_PreparedCodeItem&& prepared) {
+  r0dump_CaptureProcessState* state =
+      g_r0dump_capture_process_state.load(std::memory_order_acquire);
+  if (state == nullptr) {
+    return {.status = r0dump_CaptureStatus::kDisabled};
+  }
+  return r0dump_SubmitPreparedCodeItem(*state->staging, std::move(prepared));
+}
