+#!/usr/bin/env python3
+
+from pathlib import Path
+
+
+ART = Path(__file__).resolve().parents[2]
+
+
+def r0dump_read(relative: str) -> str:
+    return (ART / relative).read_text(encoding="utf-8")
+
+
+def r0dump_between(source: str, begin: str, end: str) -> str:
+    start = source.index(begin)
+    finish = source.index(end, start + len(begin))
+    return source[start:finish]
+
+
+def r0dump_assert_no_io(source: str) -> None:
+    for forbidden in (
+        "r0dump_Write",
+        "open(",
+        "write(",
+        "fsync(",
+        "EnsureInitialized",
+        "InvokeMethod",
+        "std::thread",
+    ):
+        assert forbidden not in source, forbidden
+
+
+def r0dump_check_capture_facade() -> None:
+    header = r0dump_read("runtime/r0dump/r0dump_capture.h")
+    source = r0dump_read("runtime/r0dump/r0dump_capture.cc")
+
+    assert "r0dump_ObserveMethodCodeItem" in header
+    assert "r0dump_ObserveMethodMetadata" in header
+    assert "ALWAYS_INLINE inline bool r0dump_IsCapturePointActiveFast" in header
+    assert "kR0dumpMaxArtifactsHardLimit" in source
+    code_item_source = r0dump_between(
+        source,
+        "bool r0dump_ObserveMethodCodeItem(",
+        "void r0dump_ObserveMethodMetadata(",
+    )
+    assert "std::unordered_set" not in code_item_source
+    code_item = r0dump_between(
+        source,
+        "bool r0dump_ObserveMethodCodeItem(",
+        "void r0dump_ObserveMethodMetadata(",
+    )
+    assert "r0dump_TryClaimMethodObservation" in code_item
+    assert "r0dump_TryPrepareCodeItem" in code_item
+    assert "r0dump_SubmitPreparedCodeItem" in code_item
+    assert code_item.index("r0dump_TryClaimMethodObservation") < code_item.index(
+        "r0dump_TryPrepareCodeItem"
+    )
+    r0dump_assert_no_io(code_item)
+
+
+def r0dump_check_art_method() -> None:
+    source = r0dump_read("runtime/art_method.cc")
+    body = r0dump_between(
+        source,
+        "void ArtMethod::Invoke(Thread* self",
+        "bool ArtMethod::IsSignaturePolymorphic()",
+    )
+    sentinel = "r0dump_TryHandleForceInvokeNoExecute(this)"
+    observer = "r0dump_ObserveMethodCodeItemOrMetadata("
+    stack_check = "self->GetStackEnd()"
+    assert body.count(observer) == 1
+    assert "r0dump_Point::kArtMethodInvokeDispatch" in body
+    assert body.index(sentinel) < body.index(stack_check) < body.index(observer)
+    assert "r0dump_IsCapturePointActiveFast" in body[body.index(stack_check) : body.index(observer)]
+    r0dump_assert_no_io(body[body.index(stack_check) : body.index(observer)])
+
+
+def r0dump_check_interpreter() -> None:
+    source = r0dump_read("runtime/interpreter/interpreter.cc")
+    body = r0dump_between(
+        source,
