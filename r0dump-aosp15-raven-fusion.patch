+  void r0dump_Merge(uint64_t point_mask, uint64_t sequence);
+};
+
+struct r0dump_DexBlobKey final {
+  r0dump_CaptureKind capture_kind = r0dump_CaptureKind::kDexView;
+  r0dump_DexFormat dex_format = r0dump_DexFormat::kNotApplicable;
+  size_t size = 0;
+  uint64_t hash = 0;
