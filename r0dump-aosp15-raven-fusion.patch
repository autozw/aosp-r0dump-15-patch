+
+void r0dump_ObserveMethodCodeItemOrMetadata(r0dump_Point point,
+                                            std::string_view site,
+                                            ArtMethod* method,
+                                            r0dump_CodeItemRole role,
+                                            uint64_t attempt_id,
+                                            std::string_view source_kind,
+                                            r0dump_RecordMetadata metadata)
+    REQUIRES_SHARED(Locks::mutator_lock_) {
+  if (!r0dump_IsCapturePointActive(point)) {
+    return;
+  }
+  if (r0dump_ObserveMethodCodeItem(point, site, method, role, attempt_id, source_kind)) {
+    return;
+  }
+  if (method != nullptr && !method->IsRuntimeMethod()) {
+    r0dump_SetMethodExecutionMetadata(method, r0dump_ObservationPhase(point), &metadata);
+    r0dump_ObserveMethodMetadata(point, site, method, std::move(metadata));
+  }
+}
+
+void r0dump_ObserveMethodMetadata(r0dump_Point point,
+                                  std::string_view site,
+                                  ArtMethod* method,
+                                  r0dump_RecordMetadata metadata)
+    REQUIRES_SHARED(Locks::mutator_lock_) {
+  if (!r0dump_IsCapturePointActive(point) || method == nullptr || method->IsRuntimeMethod()) {
+    return;
+  }
+  r0dump_CaptureProcessState* state =
+      g_r0dump_capture_process_state.load(std::memory_order_acquire);
+  DCHECK(state != nullptr);
+  r0dump_CountPointObservation(state, point);
+  r0dump_SetMethodMetadata(method, &metadata);
+  state->staging->r0dump_SubmitMetadata(r0dump_MakeHookContext(point, site), std::move(metadata));
+}
+
+r0dump_CaptureResult r0dump_TryObserveMethodMetadata(r0dump_Point point,
+                                                     std::string_view site,
+                                                     ArtMethod* method,
+                                                     r0dump_RecordMetadata metadata)
+    REQUIRES_SHARED(Locks::mutator_lock_) {
+  if (!r0dump_IsCapturePointActive(point)) {
+    return {.status = r0dump_CaptureStatus::kDisabled};
+  }
+  if (method == nullptr || method->IsRuntimeMethod()) {
+    return {.status = r0dump_CaptureStatus::kInvalidRange};
+  }
+  r0dump_CaptureProcessState* state =
+      g_r0dump_capture_process_state.load(std::memory_order_acquire);
+  DCHECK(state != nullptr);
+  r0dump_CountPointObservation(state, point);
+  r0dump_SetMethodMetadata(method, &metadata);
+  return {
+      .status = r0dump_CaptureStatus::kSubmitted,
+      .submit = state->staging->r0dump_TrySubmitMetadata(r0dump_MakeHookContext(point, site),
+                                                         std::move(metadata)),
+  };
+}
+
+void r0dump_ObserveInstrumentationMethodEvent(r0dump_Point point,
+                                              std::string_view site,
+                                              ArtMethod* method,
+                                              std::string_view dispatch_status) {
+  r0dump_RecordMetadata metadata;
+  metadata.source_kind = "instrumentation";
+  metadata.dispatch_status = dispatch_status;
+  r0dump_TryObserveMethodMetadata(point, site, method, std::move(metadata));
+}
