+#!/usr/bin/env python3
+"""Linux host regression for the production bounded memory reader."""
+from pathlib import Path
+import shutil
+import subprocess
+import tempfile
+
+ART = Path(__file__).resolve().parents[2]
+compiler = shutil.which('c++')
+if compiler is None:
+    raise SystemExit('A host C++ compiler is required')
+with tempfile.TemporaryDirectory(prefix='r0dump-memory-') as directory:
+    binary = Path(directory) / 'memory-test'
+    subprocess.run([
+        compiler, '-std=c++17', '-Wall', '-Wextra', '-Werror',
+        '-I' + str(ART / 'runtime/r0dump'),
+        str(Path(__file__).with_name('fixtures') / 'readable_memory_test.cc'),
+        str(ART / 'runtime/r0dump/r0dump_memory.cc'), '-o', str(binary),
+    ], check=True)
+    subprocess.run([str(binary)], check=True)
