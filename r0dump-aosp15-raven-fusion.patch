+TEST_F(HelperTest, RehydratedDexReceivesCapturedMethodBody) {
+  const std::string process = CreateCapturedProcess(root_);
+  std::vector<uint8_t> raw(0x1000, 0);
+  Put32(&raw, 0x100, 0x700);
+  Put32(&raw, 0x104, 0x720);
+  Put32(&raw, 0x108, 0x740);
+  const uint8_t class_name[] = {9, 'L','E','x','a','m','p','l','e',';',0};
+  const uint8_t method_name[] = {6, 't','a','r','g','e','t',0};
+  const uint8_t shorty[] = {1, 'V', 0};
+  std::copy(std::begin(class_name), std::end(class_name), raw.begin() + 0x700);
+  std::copy(std::begin(method_name), std::end(method_name), raw.begin() + 0x720);
+  std::copy(std::begin(shorty), std::end(shorty), raw.begin() + 0x740);
+  Put32(&raw, 0x200, 0); Put32(&raw, 0x204, 2);
+  Put32(&raw, 0x300, 2); Put32(&raw, 0x304, 1); // proto: ()V
+  Put32(&raw, 0x504, 1); // method name index, class/proto are both zero
+  Put32(&raw, 0x604, 1); Put32(&raw, 0x608, 0xffffffff);
+  Put32(&raw, 0x610, 0xffffffff); Put32(&raw, 0x618, 0x800);
+  const uint8_t class_data[] = {0,0,1,0,0,9,0x80,0x12};
+  std::copy(std::begin(class_data), std::end(class_data), raw.begin() + 0x800);
+  raw[0x900] = 1; // one register, public static, no arguments
+  Put32(&raw, 0x90c, 2);
+  raw[0x910] = 0x12; raw[0x912] = 0x0e; // const/4 v0,0; return-void
+  WriteBytes(process + "/artifacts/logical.raw", raw);
+  std::vector<uint8_t> code(raw.begin() + 0x900, raw.begin() + 0x914);
+  code[17] = 0x10; // captured body has const/4 v0,1
+  WriteBytes(process + "/artifacts/method.raw", code);
+  std::ofstream(process + "/records/000001.json") << R"({
+    "capture_kind":"dexdata","artifact_relative_path":"artifacts/logical.raw",
+    "dex_object_id":99,"runtime_view":{"data_begin":"0x1000",
+    "string_ids":"0x1100","type_ids":"0x1200","proto_ids":"0x1300",
+    "field_ids":"0x1400","method_ids":"0x1500","class_defs":"0x1600",
+    "section_counts_current":{"string_ids":3,"type_ids":2,"proto_ids":1,
+    "field_ids":0,"method_ids":1,"class_defs":1}}})";
+  std::ofstream(process + "/records/000002.json") << R"({
+    "capture_kind":"codeitem","artifact_relative_path":"artifacts/method.raw",
+    "dex_object_id":99,"method_index":0,"class_def_index":0,"class_name":"Example",
+    "method_name":"target","method_descriptor":"()V","code_item_size":20})";
+  const int apk_fd = CreateFixtureApk(root_);
+  ASSERT_GE(apk_fd, 0);
+  ExportSummary summary;
+  ASSERT_EQ(ExportLatest(root_, root_ + "/Downloads", "com.example.target",
+                         {apk_fd}, &summary, "run-1"), Status::kOk);
+  close(apk_fd);
+  EXPECT_EQ(summary.codeitems_backfilled, 1u);
+  ZipArchiveHandle archive = nullptr;
+  ASSERT_EQ(OpenArchive(summary.archive_path.c_str(), &archive), 0);
+  const std::string prefix = "com.example.target/run-1/process-1234/host-repair/";
+  ZipEntry entry;
+  ASSERT_EQ(FindEntry(archive, prefix + "report.json", &entry), 0);
+  std::vector<uint8_t> report_bytes(entry.uncompressed_length);
+  ASSERT_EQ(ExtractToMemory(archive, &entry, report_bytes.data(), report_bytes.size()), 0);
+  const std::string report_text(report_bytes.begin(), report_bytes.end());
+  Json::CharReaderBuilder builder;
+  std::unique_ptr<Json::CharReader> reader(builder.newCharReader());
+  Json::Value report;
+  std::string errors;
+  ASSERT_TRUE(reader->parse(report_text.data(), report_text.data()+report_text.size(), &report, &errors));
+  bool checked = false;
+  for (const auto& item : report["records"]) {
+    if (item["output_kind"].asString() != "codeitem_backfill") continue;
+    ASSERT_EQ(FindEntry(archive, prefix + item["output"].asString(), &entry), 0);
+    std::vector<uint8_t> dex(entry.uncompressed_length);
+    ASSERT_EQ(ExtractToMemory(archive, &entry, dex.data(), dex.size()), 0);
+    const size_t offset = item["backfill_offset"].asUInt();
+    ASSERT_LE(offset + code.size(), dex.size());
+    EXPECT_TRUE(std::equal(code.begin(), code.end(), dex.begin() + offset));
+    EXPECT_EQ(std::string(dex.begin(), dex.begin() + 4), "dex\n");
+    auto read32 = [&](size_t at) {
+      return static_cast<uint32_t>(dex[at]) | (static_cast<uint32_t>(dex[at+1]) << 8) |
+          (static_cast<uint32_t>(dex[at+2]) << 16) | (static_cast<uint32_t>(dex[at+3]) << 24);
+    };
+    const uint32_t map = read32(52);
+    for (uint32_t i = 0; i < read32(map); ++i) {
+      EXPECT_GT(read32(map + 4u + i * 12u + 4u), 0u);
+    }
+    checked = true;
+  }
+  EXPECT_TRUE(checked) << report_text;
+  CloseArchive(archive);
+}
