+  r0dump_StageDuplicate(pool.get(), &staging);
+  r0dump_FreezeResult frozen = staging.r0dump_TryFreeze();
+  ASSERT_EQ(frozen.status, r0dump_FreezeStatus::kFrozen);
+  r0dump_TestIoState state = {
+      .failure = r0dump_TestFailure::kWrite,
+      .fail_write_call = 3u,
+  };
+  g_r0dump_test_io_state = &state;
+  r0dump_SetFileIoForTesting(&kR0dumpTestFileIo);
+
+  r0dump_WriterState writer;
+  const r0dump_GenerationWriteResult result =
+      r0dump_WriteFrozenGeneration(run_fd, "run", 123u, *frozen.generation, &writer);
+  EXPECT_FALSE(result.ok);
+  EXPECT_EQ(result.artifacts_written, 1u);
+  EXPECT_EQ(result.records_written, 1u);
+  EXPECT_EQ(writer.r0dump_LastRecordSequence(), 1u);
+  const int artifacts_fd = r0dump_OpenDirectoryAt(run_fd, "artifacts");
+  const int records_fd = r0dump_OpenDirectoryAt(run_fd, "records");
+  ASSERT_GE(artifacts_fd, 0);
+  ASSERT_GE(records_fd, 0);
+  EXPECT_EQ(r0dump_ReadFileAt(artifacts_fd, "000001.dex.raw"), "dex");
+  EXPECT_FALSE(r0dump_ReadFileAt(records_fd, "000001.json").empty());
+  EXPECT_TRUE(r0dump_ReadFileAt(records_fd, "000002.json").empty());
+  EXPECT_EQ(staging.r0dump_FrozenCount(), 1u);
+  close(records_fd);
+  close(artifacts_fd);
+  close(run_fd);
+}
+
+TEST_F(r0dump_FileTest, RejectsDuplicateRecordSequenceBeforeWritingArtifact) {
+  const int run_fd = r0dump_OpenRun();
+  ASSERT_GE(run_fd, 0);
+  auto pool = std::make_shared<r0dump_BufferPool>(2u * kR0dumpChunkBytes);
+  r0dump_Staging staging(pool, 2u, 4u, 2u, kR0dumpChunkBytes);
+  r0dump_StageDuplicate(pool.get(), &staging);
+  r0dump_FreezeResult frozen = staging.r0dump_TryFreeze();
+  ASSERT_EQ(frozen.status, r0dump_FreezeStatus::kFrozen);
+  frozen.generation->records->at(1u).sequence = 1u;
+
+  r0dump_WriterState writer;
+  const r0dump_GenerationWriteResult result =
+      r0dump_WriteFrozenGeneration(run_fd, "run", 123u, *frozen.generation, &writer);
+  EXPECT_FALSE(result.ok);
+  EXPECT_EQ(result.operation, "validate_record");
+  EXPECT_TRUE(writer.r0dump_IsDegraded());
+  EXPECT_EQ(access((output_parent_ +
+                    "/r0dump-fusion/runs/run/process-123/artifacts/000001.dex.raw")
+                       .c_str(),
+                   F_OK),
+            -1);
+  close(run_fd);
+}
+
+TEST_F(r0dump_FileTest, SuccessfulWriteAndReleaseClearsFrozenGeneration) {
+  const int run_fd = r0dump_OpenRun();
+  ASSERT_GE(run_fd, 0);
+  auto pool = std::make_shared<r0dump_BufferPool>(kR0dumpChunkBytes);
+  r0dump_Staging staging(pool, 1u, 2u, 1u, kR0dumpChunkBytes);
+  const uint8_t bytes[] = {'d', 'e', 'x'};
+  ASSERT_EQ(staging
+                .r0dump_SubmitDex(r0dump_CaptureKind::kDexView,
+                                  r0dump_DexFormat::kStandard,
+                                  pool->r0dump_TryAcquire(bytes, sizeof(bytes)),
+                                  r0dump_Context(r0dump_Point::kCookieResultDex, "release", 1u))
+                .status,
+            r0dump_SubmitStatus::kAccepted);
+  r0dump_FreezeResult frozen = staging.r0dump_TryFreeze();
+  ASSERT_EQ(frozen.status, r0dump_FreezeStatus::kFrozen);
+
+  r0dump_WriterState writer;
+  const r0dump_GenerationWriteResult result = r0dump_WriteAndReleaseFrozenGeneration(
+      run_fd, "run", 123u, *frozen.generation, &staging, &writer);
+  EXPECT_TRUE(result.ok) << result.operation;
+  EXPECT_EQ(staging.r0dump_FrozenCount(), 0u);
+  EXPECT_FALSE(writer.r0dump_IsDegraded());
+  close(run_fd);
+}
+
+TEST_F(r0dump_FileTest, FailedWriteAndReleaseRetainsFrozenGeneration) {
+  const int run_fd = r0dump_OpenRun();
+  ASSERT_GE(run_fd, 0);
+  auto pool = std::make_shared<r0dump_BufferPool>(kR0dumpChunkBytes);
+  r0dump_Staging staging(pool, 1u, 2u, 1u, kR0dumpChunkBytes);
+  const uint8_t bytes[] = {'d', 'e', 'x'};
+  ASSERT_EQ(staging
+                .r0dump_SubmitDex(r0dump_CaptureKind::kDexView,
+                                  r0dump_DexFormat::kStandard,
+                                  pool->r0dump_TryAcquire(bytes, sizeof(bytes)),
+                                  r0dump_Context(r0dump_Point::kCookieResultDex, "retain", 1u))
+                .status,
+            r0dump_SubmitStatus::kAccepted);
+  r0dump_FreezeResult frozen = staging.r0dump_TryFreeze();
+  ASSERT_EQ(frozen.status, r0dump_FreezeStatus::kFrozen);
+  r0dump_TestIoState state = {.failure = r0dump_TestFailure::kWrite};
+  g_r0dump_test_io_state = &state;
+  r0dump_SetFileIoForTesting(&kR0dumpTestFileIo);
+
+  r0dump_WriterState writer;
+  const r0dump_GenerationWriteResult result = r0dump_WriteAndReleaseFrozenGeneration(
+      run_fd, "run", 123u, *frozen.generation, &staging, &writer);
+  EXPECT_FALSE(result.ok);
+  EXPECT_TRUE(result.degraded);
+  EXPECT_EQ(staging.r0dump_FrozenCount(), 1u);
+  EXPECT_TRUE(writer.r0dump_IsDegraded());
+  close(run_fd);
+}
+
+TEST_F(r0dump_FileTest, WritesTerminalSummaryFromBoundedState) {
+  const int run_fd = r0dump_OpenRun();
+  ASSERT_GE(run_fd, 0);
+  auto pool = std::make_shared<r0dump_BufferPool>(2u * kR0dumpChunkBytes);
+  r0dump_Staging staging(pool, 2u, 4u, 2u, 2u * kR0dumpChunkBytes);
+  r0dump_StageDuplicate(pool.get(), &staging);
+  r0dump_FreezeResult frozen = staging.r0dump_TryFreeze();
+  ASSERT_EQ(frozen.status, r0dump_FreezeStatus::kFrozen);
+  r0dump_WriterState writer;
+  ASSERT_TRUE(r0dump_WriteAndReleaseFrozenGeneration(
+                  run_fd, "run", 123u, *frozen.generation, &staging, &writer)
+                  .ok);
+  std::array<uint64_t, kR0dumpPointCount> seen = {};
+  seen[r0dump_PointIndex(r0dump_Point::kCookieResultDex)] = 2u;
+  ASSERT_TRUE(
+      r0dump_WriteSummaryFile(run_fd, staging.r0dump_GetSummary(), seen, writer, "runtime_teardown")
+          .ok);
+  const std::string summary = r0dump_ReadFileAt(run_fd, "summary.json");
+  EXPECT_NE(summary.find("\"completion_reason\":\"runtime_teardown\""), std::string::npos);
+  EXPECT_NE(summary.find("\"name\":\"Cookie.result.dex\""), std::string::npos);
+  EXPECT_NE(summary.find("\"accepted\":1"), std::string::npos);
+  EXPECT_NE(summary.find("\"duplicate\":1"), std::string::npos);
+  EXPECT_NE(summary.find("\"dex\":3"), std::string::npos);
+  EXPECT_NE(summary.find("\"frozen_generations\":1"), std::string::npos);
+  close(run_fd);
+}
+
