+@Composable
+private fun rememberPersistedUiString(
+    store: UiStateStore,
+    key: UiStateKey,
+    defaultValue: String,
+): MutableState<String> {
+    val state = rememberSaveable(key.name) { mutableStateOf(store.read(key) ?: defaultValue) }
