+};
+
+struct r0dump_HookContext final {
+  r0dump_Point point = r0dump_Point::kCookieResultDex;
+  std::string_view site;
+  uint32_t tid = 0;
+  uint64_t monotonic_ns = 0;
+};
+
+struct r0dump_RecordMetadata final {
+  std::optional<uint64_t> dex_object_id;
+  std::string location_basename;
+  std::optional<uint64_t> location_hash;
+  std::optional<uint32_t> checksum;
+  std::optional<uint64_t> declared_size;
+  std::optional<uint64_t> data_size;
+  std::optional<uint64_t> container_size;
+  std::string source_kind;
+  std::optional<uint32_t> source_ordinal;
+  std::optional<uint32_t> source_count;
+  std::optional<bool> source_in_memory;
+  std::optional<uint32_t> class_def_index;
+  std::optional<uint32_t> method_index;
+  std::optional<uint32_t> code_item_offset;
+  std::optional<uint64_t> code_item_size;
+  std::string class_name;
+  std::string method_name;
+  std::string method_descriptor;
+  std::optional<uint64_t> active_attempt_id;
+  std::string capture_role;
+  std::string load_status;
+  std::string resolve_status;
+  std::string class_init_status;
+  std::string materialize_status;
+  std::string dispatch_status;
+  std::string exception_class;
+  std::string entry_kind;
+  std::optional<uint32_t> access_flags;
+  std::optional<bool> nterp_entry_fast_path;
+  std::optional<bool> nterp_invoke_fast_path;
+  std::optional<bool> code_item_present;
+  std::string observation_phase;
