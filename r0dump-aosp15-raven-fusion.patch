+        }
+
+        @Override
+        public void r0dump_set(String key, String value) {
+          SystemProperties.set(key, value);
+        }
+      };
+
+  private static final Set<String> FIELDS =
+      Set.of(
+          "schema",
+          "enabled",
+          "run_id",
+          "target_package",
+          "target_process",
+          "capture_point_mask",
+          "max_records",
