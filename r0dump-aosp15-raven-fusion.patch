+
+constexpr std::array<r0dump_PointDescriptor, kR0dumpPointCount> kR0dumpPointDescriptors = {{
+    {r0dump_Point::kCookieResultDex, "Cookie.result.dex"},
+    {r0dump_Point::kInMemoryBufferCopied, "InMemory.buffer.copied"},
+    {r0dump_Point::kInMemoryDexParsed, "InMemory.dex.parsed"},
