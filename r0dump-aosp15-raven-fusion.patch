@@ -0,0 +1,56 @@
+#!/usr/bin/env python3
+"""Rebuild a real D8-generated DEX after erasing its header, then run dexdump."""
+from pathlib import Path
+import json
+import struct
+import subprocess
+import tempfile
+from r0dump_dex_rehydrate import HEADER_POSITIONS
+from r0dump_host_repair import r0dump_repair_run
+
+TOP = Path(__file__).resolve().parents[3]
+JAVAC = TOP / 'prebuilts/jdk/jdk21/linux-x86/bin/javac'
+D8 = TOP / 'out/host/linux-x86/bin/d8'
+DEXDUMP = TOP / 'out/host/linux-x86/bin/dexdump'
+
+def main():
+    for tool in (JAVAC, D8, DEXDUMP):
+        if not tool.is_file(): raise SystemExit(f'Required build tool missing: {tool}')
+    with tempfile.TemporaryDirectory(prefix='r0dump-roundtrip-') as directory:
+        root = Path(directory)
+        (root / 'Sample.java').write_text('public class Sample { public static int answer() { return 42; } }')
+        (root / 'd8').mkdir()
+        subprocess.run([str(JAVAC), '--release', '8', '-g:none', str(root / 'Sample.java')],
+                       check=True, capture_output=True)
+        subprocess.run([str(D8), '--min-api', '23', '--output', str(root / 'd8'),
+                        str(root / 'Sample.class')], check=True, capture_output=True)
+        original = root / 'd8/classes.dex'
+        subprocess.run([str(DEXDUMP), '-f', str(original)], check=True, capture_output=True)
+        raw = bytearray(original.read_bytes())
+        view = {'data_begin': '0x100000', 'section_counts_current': {}}
+        for name, position in HEADER_POSITIONS.items():
+            count, offset = struct.unpack_from('<II', raw, position)
+            view[name] = hex(0x100000 + offset)
+            view['section_counts_current'][name] = count
+        raw[:0x70] = bytes(0x70)
+        for kind in ('dexdata', 'dex'):
+            run = root / kind
+            (run / 'artifacts').mkdir(parents=True)
+            (run / 'records').mkdir()
+            (run / 'artifacts/logical.raw').write_bytes(raw)
+            (run / 'records/000001.json').write_text(json.dumps({
+                'capture_kind': kind, 'artifact_relative_path': 'artifacts/logical.raw',
+                'runtime_view': view,
+            }))
+            report = r0dump_repair_run(run, run / 'repair', dexdump=str(DEXDUMP))
+            item = report['records'][0]
+            assert item['trust'] == 'verified', item
+            assert item['output_kind'] == 'reconstructed_standard', item
+            assert item['dexdump']['status'] == 'passed', item
+            rebuilt = (run / 'repair' / item['output']).read_bytes()
+            assert struct.unpack_from('<I', rebuilt, 96)[0] == view['section_counts_current']['class_defs']
+            assert struct.unpack_from('<I', rebuilt, 88)[0] == view['section_counts_current']['method_ids']
+        print('PASS: real D8 input and both dexdata/dex reconstructions pass strict dexdump')
+
+if __name__ == '__main__':
+    main()
