+uint64_t r0dump_ConstantHash(const r0dump_Segment*, size_t) { return 7; }
+
+r0dump_HookContext r0dump_Context(r0dump_Point point,
+                                  std::string_view site,
+                                  uint64_t monotonic_ns) {
+  return {.point = point, .site = site, .tid = 123u, .monotonic_ns = monotonic_ns};
+}
