+
+    private fun setToolbar(
+        state: R0dumpUiState,
+        horizontal: Boolean = false,
+    ) {
+        composeTestRule.setContent {
+            R0dumpManagerTheme {
+                Box(Modifier.requiredWidth(if (horizontal) 900.dp else 400.dp)) {
+                    FusionActionToolbar(
+                        state = state,
+                        horizontal = horizontal,
+                    )
+                }
+            }
+        }
+    }
+
+    private fun dirtyState(): R0dumpUiState {
+        val state = state(snapshot = disabledSnapshot())
+        val dirtyDraft = state.draft.copy(maxRecords = state.draft.maxRecords - 1)
+        return state.copy(
+            draft = dirtyDraft,
+            validation = FusionConfigValidator.validate(dirtyDraft, true),
+        )
+    }
+
+    private fun invalidTargetProcessState(): R0dumpUiState {
+        val state = state(snapshot = disabledSnapshot())
+        val invalidDraft = state.draft.copy(targetProcess = "${state.draft.targetPackage}:")
+        return state.copy(
+            draft = invalidDraft,
+            validation = FusionConfigValidator.validate(invalidDraft, true),
+        )
+    }
+
+    private fun setToggle(
+        state: R0dumpUiState,
+        onPublishAndLaunch: () -> Unit = {},
+        onEndSession: () -> Unit = {},
+        onRecoverInterrupted: () -> Unit = {},
+    ) {
+        composeTestRule.setContent {
+            R0dumpManagerTheme {
+                CaptureStateToggle(
+                    state = state,
+                    onPublishAndLaunch = onPublishAndLaunch,
+                    onEndSession = onEndSession,
+                    onRecoverInterrupted = onRecoverInterrupted,
+                    notificationsEnabled = true,
+                    onRequestNotifications = {},
+                )
+            }
+        }
+    }
+
+    private fun state(snapshot: FusionDeviceSnapshot): R0dumpUiState {
+        val draft = snapshot.draftOrNull() ?: validDraft()
+        return R0dumpUiState(
+            draft = draft,
+            deviceSnapshot = snapshot,
+            validation = FusionConfigValidator.validate(draft, true),
+            isForeground = true,
+        )
+    }
+
+    private fun disabledSnapshot(): FusionDeviceSnapshot.Disabled {
+        val draft = validDraft().copy(enabled = false)
+        return FusionDeviceSnapshot.Disabled(draft, 40)
+    }
+
+    private fun validDraft(): FusionConfigDraft = ProfileRegistry.apply(
+        ProfileId.COOLAPK_COOKIE_WALK,
+        FusionConfigSchema.defaults().copy(
+            runId = "20260830T000000Z-market-coolapk-cookie-walk",
+            targetPackage = "com.coolapk.market",
+            targetProcess = "com.coolapk.market",
+        ),
+    )
+
+    private fun FusionDeviceSnapshot.draftOrNull(): FusionConfigDraft? = when (this) {
+        is FusionDeviceSnapshot.Disabled -> draft
+        is FusionDeviceSnapshot.Enabled -> draft
+        else -> null
+    }
+
+    private fun text(resId: Int, vararg formatArgs: Any): String = context.getString(resId, *formatArgs)
+}
diff --git a/packages/apps/R0dumpManager/tools/deploy_userdebug.sh b/packages/apps/R0dumpManager/tools/deploy_userdebug.sh
new file mode 100755
--- /dev/null
+++ b/packages/apps/R0dumpManager/tools/deploy_userdebug.sh
@@ -0,0 +1,203 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+# Incrementally deploy R0dumpManager artifacts to a debuggable physical device.
+# This script never builds or flashes a partition image.
+
+ADB_BIN="${ADB:-/mnt/c/Program Files/platformtools/adb.exe}"
+ADB_SERIAL="${ADB_SERIAL:-f5e3adbc}"
+ROOT_DIR="${ROOT_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../.." && pwd)}"
+OUT_DIR="${OUT_DIR:-$ROOT_DIR/out/target/product/lemonade}"
+WITH_FRAMEWORK=0
+WITH_ART=0
+WITH_FILE_HELPER=0
+WITH_SEPOLICY=0
+NO_REBOOT=0
+
+usage() {
+  cat <<'EOF'
+Usage: deploy_userdebug.sh [--with-framework] [--with-art]
+                           [--with-file-helper] [--with-sepolicy] [--no-reboot]
+
+By default, deploys only R0dumpManager.apk and its privapp allowlist.
+The caller must build the selected artifacts first using the userdebug lunch target.
+EOF
+}
+
+while [[ $# -gt 0 ]]; do
+  case "$1" in
+    --with-framework) WITH_FRAMEWORK=1 ;;
+    --with-art) WITH_ART=1 ;;
+    --with-file-helper) WITH_FILE_HELPER=1 ;;
+    --with-sepolicy) WITH_SEPOLICY=1 ;;
+    --no-reboot) NO_REBOOT=1 ;;
+    -h|--help) usage; exit 0 ;;
+    *) echo "unknown argument: $1" >&2; usage >&2; exit 2 ;;
+  esac
+  shift
+done
+
+[[ -x "$ADB_BIN" ]] || { echo "ADB is not executable: $ADB_BIN" >&2; exit 1; }
+
+adb_device() { "$ADB_BIN" -s "$ADB_SERIAL" "$@"; }
+fail() { echo "FAIL: $*" >&2; exit 1; }
+require_file() { [[ -f "$1" ]] || fail "missing artifact: $1"; }
+push_system_file() {
+  local source="$1"
+  local destination="$2"
+  local mode="${3:-0644}"
+  echo "push: $source -> $destination"
+  adb_device push "$source" "$destination" >/dev/null
+  adb_device shell "chown root:root '$destination' && chmod '$mode' '$destination'"
+}
+
+apk="$OUT_DIR/system/priv-app/R0dumpManager/R0dumpManager.apk"
+privapp="$OUT_DIR/system/etc/permissions/privapp-permissions-com.android.r0dumpmanager.xml"
+framework="$OUT_DIR/system/framework/framework.jar"
+framework_res="$OUT_DIR/system/framework/framework-res.apk"
+services="$OUT_DIR/system/framework/services.jar"
+art_apex="$OUT_DIR/system/apex/com.android.art.capex"
+file_helper="$OUT_DIR/system/bin/r0dump_file_helper"
+file_helper_rc="$OUT_DIR/system/etc/init/r0dump_file_helper.rc"
+mcp_bridge="$OUT_DIR/system/bin/r0dump_mcp_bridge"
+policy="$OUT_DIR/system/etc/selinux/plat_sepolicy.cil"
+seapp="$OUT_DIR/system/etc/selinux/plat_seapp_contexts"
+property_contexts="$OUT_DIR/system/etc/selinux/plat_property_contexts"
+file_contexts="$OUT_DIR/system/etc/selinux/plat_file_contexts"
+policy_hash="$OUT_DIR/system/etc/selinux/plat_sepolicy_and_mapping.sha256"
+
+# Split-policy devices compile platform, system_ext, and product policy
+# together when the vendor precompiled policy hash no longer matches.  Keep
+# these artifacts from the same Soong graph so a framework-only overlay cannot
+# leave init with an incompatible system_ext/product CIL pair.
+sepolicy_intermediates="$ROOT_DIR/out/soong/.intermediates/system/sepolicy"
+product_name="$(basename "$OUT_DIR")"
+plat_mapping="$(find "$sepolicy_intermediates/plat_mapping_file/android_common" \
+  -maxdepth 1 -type f -name '*.cil' -print -quit 2>/dev/null || true)"
+system_ext_policy="$sepolicy_intermediates/system_ext_sepolicy.cil/android_common/$product_name/system_ext_sepolicy.cil"
+system_ext_mapping="$(find "$sepolicy_intermediates/system_ext_mapping_file/android_common/$product_name" \
+  -maxdepth 1 -type f -name '*.cil' -print -quit 2>/dev/null || true)"
+system_ext_hash="$sepolicy_intermediates/system_ext_sepolicy_and_mapping.sha256/android_arm64_armv8-2a-dotprod_cortex-a76/system_ext_sepolicy_and_mapping.sha256"
+product_policy="$sepolicy_intermediates/product_sepolicy.cil/android_common/$product_name/product_sepolicy.cil"
+product_mapping="$(find "$sepolicy_intermediates/product_mapping_file/android_common/$product_name" \
+  -maxdepth 1 -type f -name '*.cil' -print -quit 2>/dev/null || true)"
+product_hash="$sepolicy_intermediates/product_sepolicy_and_mapping.sha256/android_arm64_armv8-2a-dotprod_cortex-a76/product_sepolicy_and_mapping.sha256"
+genfs_policy="$(find "$sepolicy_intermediates/compat" \
+  -maxdepth 4 -type f -name 'plat_sepolicy_genfs_*.cil' -print -quit 2>/dev/null || true)"
+
+# The hash is emitted as a Soong intermediate on some trees and is only copied
+# into system.img during image packaging. Accept that intermediate for adb push.
+if [[ ! -f "$policy_hash" ]]; then
+  policy_hash="$(find "$ROOT_DIR/out/soong/.intermediates/system/sepolicy/plat_sepolicy_and_mapping.sha256" \
+    -type f -name plat_sepolicy_and_mapping.sha256 -print -quit 2>/dev/null || true)"
+fi
+
+require_file "$apk"
+require_file "$privapp"
+if [[ "$WITH_FRAMEWORK" -eq 1 ]]; then
+  require_file "$framework"
+  require_file "$framework_res"
+  require_file "$services"
+fi
+if [[ "$WITH_ART" -eq 1 ]]; then
+  require_file "$art_apex"
+fi
+if [[ "$WITH_FILE_HELPER" -eq 1 ]]; then
+  require_file "$file_helper"
+  require_file "$file_helper_rc"
+  require_file "$mcp_bridge"
+fi
+if [[ "$WITH_SEPOLICY" -eq 1 ]]; then
+  require_file "$policy"
+  require_file "$seapp"
+  require_file "$property_contexts"
+  require_file "$file_contexts"
+  require_file "$policy_hash"
+  require_file "$plat_mapping"
+  require_file "$system_ext_policy"
+  require_file "$system_ext_mapping"
+  require_file "$system_ext_hash"
+  require_file "$product_policy"
+  require_file "$product_mapping"
+  require_file "$product_hash"
+fi
+
+state="$("$ADB_BIN" devices | tr -d '\r' | awk -v serial="$ADB_SERIAL" '$1 == serial {print $2}')"
+[[ "$state" == "device" ]] || fail "device $ADB_SERIAL is not available through ADB (state=${state:-missing})"
+
+build_type="$(adb_device shell getprop ro.build.type | tr -d '\r')"
+[[ "$build_type" == "userdebug" || "$build_type" == "eng" ]] ||
+  fail "incremental deployment requires userdebug/eng, found $build_type"
+
+echo "rooting adbd on $ADB_SERIAL ($build_type)"
+adb_device root >/dev/null
+adb_device wait-for-device
+[[ "$(adb_device shell id -u | tr -d '\r')" == "0" ]] || fail "adbd did not restart as root"
+
+remount_output="$(adb_device remount 2>&1 | tr -d '\r')"
+printf '%s\n' "$remount_output"
+grep -Eiq 'remount succeeded|remounted.*read-write|already mounted.*read-write' <<<"$remount_output" ||
+  fail "adb remount did not report success"
+
+adb_device shell am force-stop com.android.r0dumpmanager || true
+
+adb_device shell mkdir -p \
+  /system/priv-app/R0dumpManager /system/etc/permissions /system/framework \
+  /system/apex /system/bin /system/etc/init \
+  /system/etc/selinux /system/etc/selinux/mapping \
+  /system_ext/etc/selinux /system_ext/etc/selinux/mapping \
+  /product/etc/selinux /product/etc/selinux/mapping
+push_system_file "$apk" /system/priv-app/R0dumpManager/R0dumpManager.apk
+push_system_file "$privapp" /system/etc/permissions/privapp-permissions-com.android.r0dumpmanager.xml
+
+if [[ "$WITH_FRAMEWORK" -eq 1 ]]; then
+  push_system_file "$framework" /system/framework/framework.jar
+  push_system_file "$framework_res" /system/framework/framework-res.apk
+  push_system_file "$services" /system/framework/services.jar
+fi
+
+if [[ "$WITH_ART" -eq 1 ]]; then
+  push_system_file "$art_apex" /system/apex/com.android.art.capex
+fi
+
+if [[ "$WITH_FILE_HELPER" -eq 1 ]]; then
+  push_system_file "$file_helper" /system/bin/r0dump_file_helper 0755
+  push_system_file "$file_helper_rc" /system/etc/init/r0dump_file_helper.rc
+  push_system_file "$mcp_bridge" /system/bin/r0dump_mcp_bridge 0755
+fi
+
+if [[ "$WITH_SEPOLICY" -eq 1 ]]; then
+  # Force split-policy compilation using policy pieces from one Soong graph.
+  push_system_file "$policy_hash" /system/etc/selinux/plat_sepolicy_and_mapping.sha256
+  push_system_file "$policy" /system/etc/selinux/plat_sepolicy.cil
+  push_system_file "$seapp" /system/etc/selinux/plat_seapp_contexts
+  push_system_file "$property_contexts" /system/etc/selinux/plat_property_contexts
+  push_system_file "$file_contexts" /system/etc/selinux/plat_file_contexts
+  push_system_file "$plat_mapping" "/system/etc/selinux/mapping/$(basename "$plat_mapping")"
+  push_system_file "$system_ext_policy" /system_ext/etc/selinux/system_ext_sepolicy.cil
+  push_system_file "$system_ext_mapping" "/system_ext/etc/selinux/mapping/$(basename "$system_ext_mapping")"
+  push_system_file "$system_ext_hash" /system_ext/etc/selinux/system_ext_sepolicy_and_mapping.sha256
+  push_system_file "$product_policy" /product/etc/selinux/product_sepolicy.cil
+  push_system_file "$product_mapping" "/product/etc/selinux/mapping/$(basename "$product_mapping")"
+  push_system_file "$product_hash" /product/etc/selinux/product_sepolicy_and_mapping.sha256
+  if [[ -n "$genfs_policy" ]]; then
+    push_system_file "$genfs_policy" "/system/etc/selinux/$(basename "$genfs_policy")"
+  fi
+fi
+
+adb_device shell restorecon \
+  /system/priv-app/R0dumpManager/R0dumpManager.apk \
+  /system/etc/permissions/privapp-permissions-com.android.r0dumpmanager.xml \
+  /system/bin/r0dump_file_helper \
+  /system/bin/r0dump_mcp_bridge \
+  /system/etc/init/r0dump_file_helper.rc \
+  /system/apex/com.android.art.capex || true
+adb_device shell sync
+
+echo "deployed R0dumpManager artifacts successfully"
+if [[ "$NO_REBOOT" -eq 0 ]]; then
+  echo "rebooting device"
+  adb_device reboot
+else
+  echo "reboot skipped; changes requiring Framework or SELinux are not active yet"
+fi
diff --git a/packages/apps/R0dumpManager/tools/export_latest.py b/packages/apps/R0dumpManager/tools/export_latest.py
new file mode 100755
--- /dev/null
+++ b/packages/apps/R0dumpManager/tools/export_latest.py
@@ -0,0 +1,451 @@
+#!/usr/bin/env python3
+"""Export the newest R0dump run for a package through adb and repair it locally."""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path, PurePosixPath
+import re
+import shutil
+import shlex
+import subprocess
+import sys
+import tempfile
+import zipfile
+from dataclasses import dataclass
+from datetime import datetime, timezone
+from typing import Any, Sequence
+
+
+AOSP_ROOT = Path(__file__).resolve().parents[4]
+HOST_REPAIR_DIR = AOSP_ROOT / "art" / "tools" / "r0dump"
+sys.path.insert(0, str(HOST_REPAIR_DIR))
+
+try:
+    from r0dump_host_repair import R0DUMP_ALGORITHM_VERSION, r0dump_repair_run
+except ImportError as exc:  # pragma: no cover - only possible outside the source tree.
+    raise SystemExit(f"无法加载 {HOST_REPAIR_DIR / 'r0dump_host_repair.py'}：{exc}") from exc
+
+
+PACKAGE_RE = re.compile(r"^[A-Za-z][A-Za-z0-9_]*(?:\.[A-Za-z][A-Za-z0-9_]*)+$")
+REMOTE_TEMPLATE = "/sdcard/Android/data/{package}/files/r0dump-fusion/runs"
+
+
+class ExportError(RuntimeError):
+    """An expected user-facing export failure."""
+
+
+@dataclass(frozen=True)
+class RunCandidate:
+    latest_artifact_mtime: int
+    artifact_count: int
+    remote_path: str
+
+    @property
+    def run_id(self) -> str:
+        return PurePosixPath(self.remote_path).name
+
+
+class AdbClient:
+    def __init__(self, adb: str, serial: str | None, verbose: bool = False) -> None:
+        self._prefix = [adb]
+        if serial:
+            self._prefix.extend(["-s", serial])
+        self.verbose = verbose
+
+    def run(self, *args: str, capture: bool = True) -> subprocess.CompletedProcess[str]:
+        command = [*self._prefix, *args]
+        if self.verbose:
+            print("+", shlex.join(command), file=sys.stderr)
+        try:
+            return subprocess.run(
+                command,
+                check=True,
+                text=True,
+                stdout=subprocess.PIPE if capture else None,
+                stderr=subprocess.PIPE if capture else None,
+            )
+        except FileNotFoundError as exc:
+            raise ExportError(f"找不到 adb：{self._prefix[0]}") from exc
+        except subprocess.CalledProcessError as exc:
+            details = (exc.stderr or exc.stdout or "").strip()
+            suffix = f"：{details}" if details else ""
+            raise ExportError(f"adb 命令失败（exit {exc.returncode}）{suffix}") from exc
+
+    def ensure_device(self) -> str:
+        state = self.run("get-state").stdout.strip()
+        if state != "device":
+            raise ExportError(f"设备状态不可用：{state or 'unknown'}")
+        return self.run("get-serialno").stdout.strip()
+
+    def shell(self, script: str) -> str:
+        return self.run("shell", script).stdout
+
+    def pull(self, remote: str, local_directory: Path) -> None:
+        self.run("pull", remote, str(local_directory), capture=False)
+
+
+def validate_package_name(package: str) -> str:
+    if not PACKAGE_RE.fullmatch(package):
+        raise ExportError(f"无效包名：{package!r}")
+    return package
+
+
+def remote_runs_root(package: str) -> str:
+    return REMOTE_TEMPLATE.format(package=validate_package_name(package))
+
+
+def candidate_script(root: str) -> str:
+    quoted_root = shlex.quote(root)
+    return f"""
+root={quoted_root}
+for run in "$root"/*; do
+  [ -d "$run" ] || continue
+  newest=0
+  count=0
+  for process in "$run"/process-*; do
+    [ -f "$process/session.json" ] || continue
+    for artifact in "$process"/artifacts/*; do
+      [ -f "$artifact" ] || continue
+      mtime=$(stat -c %Y "$artifact" 2>/dev/null) || continue
+      [ "$mtime" -gt "$newest" ] && newest=$mtime
+      count=$((count + 1))
+    done
+  done
+  [ "$count" -gt 0 ] && printf '%s\\t%s\\t%s\\n' "$newest" "$count" "$run"
+done
+exit 0
+""".strip()
+
+
+def run_path(root: str, run_id: str) -> str:
+    """Return a validated device run path without enumerating historical runs."""
+    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]{0,127}", run_id):
+        raise ExportError(f"无效 run id：{run_id!r}")
+    return f"{root}/{run_id}"
+
+
+def parse_candidates(output: str, root: str) -> list[RunCandidate]:
+    expected_parent = PurePosixPath(root)
+    candidates: list[RunCandidate] = []
+    for line in output.splitlines():
+        if not line.strip():
+            continue
+        fields = line.split("\t", 2)
+        if len(fields) != 3:
+            raise ExportError(f"无法解析设备返回的 run 信息：{line!r}")
+        try:
+            mtime = int(fields[0])
+            count = int(fields[1])
+        except ValueError as exc:
+            raise ExportError(f"设备返回了无效的 run 统计：{line!r}") from exc
+        remote_path = fields[2]
+        path = PurePosixPath(remote_path)
+        if path.parent != expected_parent or not path.name or count <= 0 or mtime < 0:
+            raise ExportError(f"设备返回了越界的 run 路径：{remote_path!r}")
+        candidates.append(RunCandidate(mtime, count, remote_path))
+    return candidates
+
+
+def select_run(candidates: Sequence[RunCandidate], run_id: str | None) -> RunCandidate:
+    if not candidates:
+        raise ExportError("目标包下没有包含产物的 run")
+    if run_id is not None:
+        matches = [candidate for candidate in candidates if candidate.run_id == run_id]
+        if not matches:
+            raise ExportError(f"找不到包含产物的 run：{run_id}")
+        return matches[0]
+    return max(candidates, key=lambda candidate: (candidate.latest_artifact_mtime, candidate.run_id))
+
+
+def resolve_optional_tool(value: str | None, name: str) -> str | None:
+    if value is None:
+        return None
+    discovered = shutil.which(value)
+    if discovered:
+        return str(Path(discovered).resolve())
+    path = Path(value).expanduser().resolve()
+    if not path.is_file() or not os.access(path, os.X_OK):
+        raise ExportError(f"{name} 不存在或不可执行：{value}")
+    return str(path)
+
+
+def repair_summary(report: dict[str, Any]) -> dict[str, Any]:
+    records = report.get("records", [])
+    partial_records = [
+        item
+        for item in records
+        if item.get("trust") == "partial" or item.get("status") == "partial"
+    ]
+    partial_reasons: dict[str, int] = {}
+    for item in partial_records:
+        reason = str(item.get("reason") or "unspecified")
+        if reason == "capture_dropped" and item.get("drop_reason"):
+            reason = f"{reason}:{item['drop_reason']}"
+        partial_reasons[reason] = partial_reasons.get(reason, 0) + 1
+    return {
+        "verified": sum(item.get("trust") == "verified" for item in records),
+        "repaired": sum(item.get("trust") == "repaired" for item in records),
+        "partial": len(partial_records),
+        "usable_outputs": len(
+            {
+                item.get("output")
+                for item in records
+                if item.get("trust") in ("verified", "repaired") and item.get("output")
+            }
+        ),
+        "codeitems_backfilled": sum(
+            item.get("output_kind") == "codeitem_backfill" and item.get("trust") == "repaired"
+            for item in records
+        ),
+        "reconstructed_dex": sum(
+            reconstruction.get("output") is not None
+            for reconstruction in report.get("reconstructions", [])
+        ),
+        "partial_reasons": dict(sorted(partial_reasons.items())),
+    }
+
+
+def repair_export(
+    run_directory: Path,
+    dexdump: str | None = None,
+    jadx: str | None = None,
+) -> list[dict[str, Any]]:
+    process_reports: list[dict[str, Any]] = []
+    process_directories = sorted(
+        path
+        for path in run_directory.glob("process-*")
+        if path.is_dir() and (path / "session.json").is_file()
+    )
+    if not process_directories:
+        raise ExportError("导出的 run 不包含有效 process 目录")
+
+    for process_directory in process_directories:
+        output_directory = process_directory / "host-repair"
+        try:
+            report = r0dump_repair_run(process_directory, output_directory, dexdump, jadx)
+            process_reports.append(
+                {
+                    "process": process_directory.name,
+                    "status": "ok",
+                    "algorithm_version": R0DUMP_ALGORITHM_VERSION,
+                    "record_count": report.get("record_count", 0),
+                    "summary": repair_summary(report),
+                    "report": (output_directory / "report.json").relative_to(run_directory).as_posix(),
+                    "inputs": (output_directory / "inputs.json").relative_to(run_directory).as_posix(),
+                }
+            )
+        # Preserve the raw export and surface a per-process diagnostic even if
+        # a malformed record triggers an unexpected parser failure.
+        except Exception as exc:
+            process_reports.append(
+                {"process": process_directory.name, "status": "error", "error": str(exc)}
+            )
+    return process_reports
+
+
+def write_export_report(
+    run_directory: Path,
+    package: str,
+    serial: str,
+    candidate: RunCandidate,
+    process_reports: Sequence[dict[str, Any]],
+    archive_name: str,
+) -> Path:
+    report = {
+        "schema": 1,
+        "exported_at": datetime.now(timezone.utc).isoformat(),
+        "device_serial": serial,
+        "package": package,
+        "run_id": candidate.run_id,
+        "remote_path": candidate.remote_path,
+        "remote_artifact_count": candidate.artifact_count,
+        "archive": archive_name,
+        "process_reports": list(process_reports),
+    }
+    path = run_directory / "export-report.json"
+    temporary = run_directory / ".export-report.json.tmp"
+    temporary.write_text(json.dumps(report, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
+    temporary.replace(path)
+    return path
+
+
+def sha256_file(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as stream:
+        for chunk in iter(lambda: stream.read(1024 * 1024), b""):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def create_archive(run_directory: Path, package: str, archive: Path) -> tuple[Path, Path]:
+    temporary = archive.with_name(f".{archive.name}.partial")
+    checksum_path = archive.with_suffix(archive.suffix + ".sha256")
+    if archive.exists() or checksum_path.exists():
+        raise ExportError(f"ZIP 或校验文件已存在，不会覆盖：{archive}")
+    try:
+        with zipfile.ZipFile(
+            temporary,
+            "w",
+            compression=zipfile.ZIP_DEFLATED,
+            compresslevel=6,
+            allowZip64=True,
+        ) as output:
+            for path in sorted(run_directory.rglob("*")):
+                if path.is_symlink():
+                    raise ExportError(f"导出目录包含不允许打包的符号链接：{path}")
+                if not path.is_file():
+                    continue
+                relative = path.relative_to(run_directory)
+                archive_name = (PurePosixPath(package) / run_directory.name / relative.as_posix()).as_posix()
+                output.write(path, archive_name)
+        temporary.replace(archive)
+    finally:
+        temporary.unlink(missing_ok=True)
+    checksum = sha256_file(archive)
+    checksum_temporary = checksum_path.with_name(f".{checksum_path.name}.partial")
+    checksum_temporary.write_text(f"{checksum}  {archive.name}\n", encoding="utf-8")
+    checksum_temporary.replace(checksum_path)
+    return archive, checksum_path
+
+
+def pull_run(client: AdbClient, candidate: RunCandidate, destination: Path) -> None:
+    package_directory = destination.parent
+    temporary = Path(
+        tempfile.mkdtemp(prefix=f".{candidate.run_id}.partial-", dir=package_directory)
+    )
+    try:
+        pulled = temporary / candidate.run_id
+        pulled.mkdir()
+        # Pull directory contents into a local name we control. Windows adb invoked from WSL may
+        # truncate the remote basename when it creates the destination directory itself.
+        client.pull(f"{candidate.remote_path}/.", pulled)
+        if not any(pulled.glob("process-*/session.json")):
+            raise ExportError("导出的 run 缺少 process session.json")
+        if not any(pulled.glob("process-*/artifacts/*")):
+            raise ExportError("导出的 run 不包含产物")
+        pulled.rename(destination)
+    finally:
+        shutil.rmtree(temporary, ignore_errors=True)
+
+
+def export_latest(args: argparse.Namespace) -> Path:
+    package = validate_package_name(args.package)
+    client = AdbClient(args.adb, args.serial, args.verbose)
+    serial = client.ensure_device()
+    root = remote_runs_root(package)
+    if args.run_id is None:
+        candidate = select_run(parse_candidates(client.shell(candidate_script(root)), root), None)
+    else:
+        remote_path = run_path(root, args.run_id)
+        candidate = RunCandidate(latest_artifact_mtime=0, artifact_count=1, remote_path=remote_path)
+        # Validate the explicitly requested run before adb pull. This avoids a shell glob over all
+        # historical runs and produces a focused error for a missing/empty run.
+        probe = client.shell(
+            f"run={shlex.quote(remote_path)}; "
+            "[ -d \"$run\" ] || { echo missing >&2; exit 1; }; "
+            "count=0; for process in \"$run\"/process-*; do "
+            "[ -f \"$process/session.json\" ] || continue; "
+            "for artifact in \"$process\"/artifacts/*; do [ -f \"$artifact\" ] && count=$((count + 1)); done; "
+            "done; [ \"$count\" -gt 0 ] || { echo empty >&2; exit 1; }; printf '%s\\n' \"$count\""
+        ).strip()
+        try:
+            candidate = RunCandidate(
+                latest_artifact_mtime=0,
+                artifact_count=int(probe),
+                remote_path=remote_path,
+            )
+        except ValueError as exc:
+            raise ExportError(f"设备返回了无效的 run 统计：{probe!r}") from exc
+    dexdump = None if args.no_repair else resolve_optional_tool(args.dexdump, "dexdump")
+    jadx = None if args.no_repair else resolve_optional_tool(args.jadx, "jadx")
+
+    output_root = Path(args.output).expanduser().resolve()
+    package_directory = output_root / package
+    destination = package_directory / candidate.run_id
+    archive = package_directory / f"{candidate.run_id}.zip"
+    checksum_path = archive.with_suffix(archive.suffix + ".sha256")
+    if destination.exists() or archive.exists() or checksum_path.exists():
+        raise ExportError(f"导出目录或 ZIP 已存在，不会覆盖：{destination}")
+    package_directory.mkdir(parents=True, exist_ok=True)
+
+    pull_run(client, candidate, destination)
+
+    process_reports: list[dict[str, Any]] = []
+    if not args.no_repair:
+        process_reports = repair_export(destination, dexdump, jadx)
+    report_path = write_export_report(
+        destination, package, serial, candidate, process_reports, archive.name
+    )
+    archive_path, archive_checksum_path = create_archive(destination, package, archive)
+
+    print(f"设备：{serial}")
+    print(f"包名：{package}")
+    print(f"run：{candidate.run_id}（{candidate.artifact_count} 个设备端产物）")
+    print(f"导出：{destination}")
+    if args.no_repair:
+        print("主机修复：已跳过")
+    else:
+        for item in process_reports:
+            if item["status"] == "ok":
+                summary = item["summary"]
+                print(
+                    f"{item['process']}：{summary['verified']} verified，"
+                    f"{summary['repaired']} repaired，{summary['partial']} partial，"
+                    f"{summary['usable_outputs']} 个去重可用 DEX，"
+                    f"{summary['codeitems_backfilled']} 条 codeitem 已回填"
+                )
+                if summary["partial_reasons"]:
+                    reasons = "，".join(
+                        f"{reason}={count}"
+                        for reason, count in summary["partial_reasons"].items()
+                    )
+                    print(f"  partial 原因：{reasons}")
+            else:
+                print(f"{item['process']}：修复失败：{item['error']}", file=sys.stderr)
+    print(f"报告：{report_path}")
+    print(f"ZIP：{archive_path}")
+    print(f"SHA-256：{archive_checksum_path}")
+    if any(item["status"] != "ok" for item in process_reports):
+        raise ExportError(f"原始 run 已导出，但至少一个 process 修复失败：{destination}")
+    return archive_path
+
+
+def build_parser() -> argparse.ArgumentParser:
+    parser = argparse.ArgumentParser(
+        description="通过 adb 导出指定包最新的 R0dump run，并调用主机修复器处理。"
+    )
+    parser.add_argument("package", help="目标 Android 包名，例如 com.coolapk.market")
+    parser.add_argument(
+        "-o",
+        "--output",
+        default="r0dump-exports",
+        help="导出根目录（默认：./r0dump-exports）",
+    )
+    parser.add_argument("-s", "--serial", default=os.environ.get("ADB_SERIAL"), help="adb 设备序列号")
+    parser.add_argument("--adb", default=os.environ.get("ADB", "adb"), help="adb 可执行文件")
+    parser.add_argument("--run-id", help="导出指定 run；默认按最新产物修改时间选择")
+    parser.add_argument("--no-repair", action="store_true", help="只导出，不运行主机修复器")
+    parser.add_argument("--dexdump", help="可选 dexdump 路径；对 repaired DEX 做解析校验")
+    parser.add_argument("--jadx", help="可选 jadx 路径；对 repaired DEX 做反编译验证")
+    parser.add_argument("-v", "--verbose", action="store_true", help="打印执行的 adb 命令")
+    return parser
+
+
+def main(argv: Sequence[str] | None = None) -> int:
+    try:
+        export_latest(build_parser().parse_args(argv))
+        return 0
+    except ExportError as exc:
+        print(f"错误：{exc}", file=sys.stderr)
+        return 1
+    except KeyboardInterrupt:
+        print("已取消", file=sys.stderr)
+        return 130
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/packages/apps/R0dumpManager/tools/final_acceptance.sh b/packages/apps/R0dumpManager/tools/final_acceptance.sh
new file mode 100755
--- /dev/null
+++ b/packages/apps/R0dumpManager/tools/final_acceptance.sh
@@ -0,0 +1,127 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+# R0dump Manager final acceptance wrapper.
+#
+# This script intentionally does NOT flash partitions. It is the reproducible
+# post-deployment gate for the jointly built Manager, Framework and SELinux
+# artifacts. A userdebug device is the authoritative acceptance target; a user
+# build and system.img are intentionally not prerequisites.
+# By default it is non-destructive: source checks + device/system identity + UI
+# smoke only. Configuration mutations are deliberately not driven by this script. Use
+# --preflight-only before flashing to collect
+# current hashes without running the post-flash gate.
+#
+# Examples:
+#   ADB=adb ADB_HOST=127.0.0.1 ADB_PORT=5038 ADB_SERIAL=f5e3adbc \
+#     packages/apps/R0dumpManager/tools/final_acceptance.sh
+
+ADB="${ADB:-adb}"
+ADB_HOST="${ADB_HOST:-127.0.0.1}"
+ADB_PORT="${ADB_PORT:-5037}"
+ADB_SERIAL="${ADB_SERIAL:-f5e3adbc}"
+ROOT_DIR="${ROOT_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../.." && pwd)}"
+OUT_DIR="${OUT_DIR:-$ROOT_DIR/out/target/product/lemonade}"
+TOOLS_DIR="$ROOT_DIR/packages/apps/R0dumpManager/tools"
+ARTIFACT_DIR="${ARTIFACT_DIR:-/tmp/r0dump-manager-final-acceptance-$(date +%Y%m%d-%H%M%S)}"
+ALLOW_START_DUMP=0
+TARGET_PACKAGE="${TARGET_PACKAGE:-com.android.settings}"
+RESET_MANAGER_DATA=0
+PREFLIGHT_ONLY=0
+
+while [[ $# -gt 0 ]]; do
+  case "$1" in
+    --allow-start-dump)
+      ALLOW_START_DUMP=1
+      shift
+      ;;
+    --target)
+      TARGET_PACKAGE="${2:?missing target package}"
+      shift 2
+      ;;
+    --reset-manager-data)
+      RESET_MANAGER_DATA=1
+      shift
+      ;;
+    --preflight-only)
+      PREFLIGHT_ONLY=1
+      shift
+      ;;
+    --artifact-dir)
+      ARTIFACT_DIR="${2:?missing artifact dir}"
+      shift 2
+      ;;
+    -h|--help)
+      sed -n '1,31p' "$0"
+      exit 0
+      ;;
+    *)
+      echo "unknown argument: $1" >&2
+      exit 2
+      ;;
+  esac
+done
+
+mkdir -p "$ARTIFACT_DIR"
+
+log() { printf '\n== %s ==\n' "$*"; }
+adb_base=("$ADB" -H "$ADB_HOST" -P "$ADB_PORT" -s "$ADB_SERIAL")
+adb_device() { "${adb_base[@]}" "$@"; }
+
+log "tool configuration"
+{
+  echo "ROOT_DIR=$ROOT_DIR"
+  echo "OUT_DIR=$OUT_DIR"
+  echo "ADB=$ADB"
+  echo "ADB_ENDPOINT=$ADB_HOST:$ADB_PORT"
+  echo "ADB_SERIAL=$ADB_SERIAL"
+  echo "ARTIFACT_DIR=$ARTIFACT_DIR"
+  echo "TARGET_PACKAGE=$TARGET_PACKAGE"
+  echo "ALLOW_START_DUMP=$ALLOW_START_DUMP"
+  echo "RESET_MANAGER_DATA=$RESET_MANAGER_DATA"
+  echo "PREFLIGHT_ONLY=$PREFLIGHT_ONLY"
+} | tee "$ARTIFACT_DIR/final_acceptance_config.txt"
+
+log "source contracts"
+"$TOOLS_DIR/validate_source_contracts.sh" | tee "$ARTIFACT_DIR/source_contracts.txt"
+
+log "local artifact hashes"
+sha256sum \
+  "$OUT_DIR/system/priv-app/R0dumpManager/R0dumpManager.apk" \
+  "$OUT_DIR/system/etc/selinux/plat_sepolicy.cil" \
+  "$OUT_DIR/system/etc/permissions/privapp-permissions-com.android.r0dumpmanager.xml" \
+  | tee "$ARTIFACT_DIR/local_hashes.txt"
+
+if [[ "$PREFLIGHT_ONLY" -eq 1 ]]; then
+  log "device preflight hashes"
+  {
+    "$ADB" -H "$ADB_HOST" -P "$ADB_PORT" devices -l || true
+    adb_device shell 'sha256sum /system/priv-app/R0dumpManager/R0dumpManager.apk 2>/dev/null || true' || true
+    adb_device shell 'sha256sum /system/etc/selinux/plat_sepolicy.cil 2>/dev/null || true' || true
+    adb_device shell 'sha256sum /system/etc/permissions/privapp-permissions-com.android.r0dumpmanager.xml 2>/dev/null || true' || true
+  } | tee "$ARTIFACT_DIR/device_preflight_hashes.txt"
+  log "preflight summary"
+  cat <<SUMMARY | tee "$ARTIFACT_DIR/summary.txt"
+PASS: R0dumpManager final acceptance preflight completed
+Artifacts: $ARTIFACT_DIR
+Post-flash validation: skipped by --preflight-only
+SUMMARY
+  exit 0
+fi
+
+log "post-deployment manager validation"
+post_args=(--allow-userdebug --require-system-match --artifact-dir "$ARTIFACT_DIR/post_flash")
+if [[ "$RESET_MANAGER_DATA" -eq 1 ]]; then
+  post_args+=(--reset-manager-data)
+fi
+ADB="$ADB" ADB_HOST="$ADB_HOST" ADB_PORT="$ADB_PORT" ADB_SERIAL="$ADB_SERIAL" \
+  OUT_DIR="$OUT_DIR" "$TOOLS_DIR/validate_post_flash.sh" "${post_args[@]}" \
+  | tee "$ARTIFACT_DIR/post_flash_validation.txt"
+
+log "final acceptance summary"
+cat <<SUMMARY | tee "$ARTIFACT_DIR/summary.txt"
+PASS: R0dumpManager final acceptance wrapper completed
+Artifacts: $ARTIFACT_DIR
+Userdebug property, SELinux and UI validation: passed
+User build/system.img prerequisite: not required
+SUMMARY
diff --git a/packages/apps/R0dumpManager/tools/test_export_latest.py b/packages/apps/R0dumpManager/tools/test_export_latest.py
new file mode 100755
--- /dev/null
+++ b/packages/apps/R0dumpManager/tools/test_export_latest.py
@@ -0,0 +1,180 @@
+#!/usr/bin/env python3
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+import sys
+import tempfile
+import unittest
+import zipfile
+
+
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+
+import export_latest  # noqa: E402
+
+
+class ExportLatestTest(unittest.TestCase):
+    def test_parse_and_select_newest_candidate(self) -> None:
+        root = "/sdcard/Android/data/com.example.app/files/r0dump-fusion/runs"
+        candidates = export_latest.parse_candidates(
+            f"100\t2\t{root}/older\n200\t1\t{root}/newer\n", root
+        )
+        self.assertEqual("newer", export_latest.select_run(candidates, None).run_id)
+        self.assertEqual("older", export_latest.select_run(candidates, "older").run_id)
+        self.assertTrue(export_latest.candidate_script(root).endswith("exit 0"))
+
+    def test_rejects_invalid_package_and_remote_path(self) -> None:
+        with self.assertRaises(export_latest.ExportError):
+            export_latest.validate_package_name("com.example;id")
+        root = "/sdcard/Android/data/com.example.app/files/r0dump-fusion/runs"
+        with self.assertRaises(export_latest.ExportError):
+            export_latest.parse_candidates("1\t1\t/sdcard/other/run\n", root)
+
+    def test_explicit_run_path_is_validated_without_history_scan(self) -> None:
+        root = "/sdcard/Android/data/com.example.app/files/r0dump-fusion/runs"
+        self.assertEqual(
+            f"{root}/20260902TVCB-ui-targeted",
+            export_latest.run_path(root, "20260902TVCB-ui-targeted"),
+        )
+        for run_id in ("../escape", "run/child", "", "x" * 129):
+            with self.assertRaises(export_latest.ExportError):
+                export_latest.run_path(root, run_id)
+
+    def test_pull_run_uses_precreated_exact_destination(self) -> None:
+        class FakeClient:
+            remote = None
+            local = None
+
+            def pull(self, remote: str, local: Path) -> None:
+                self.remote = remote
+                self.local = local
+                process = local / "process-42"
+                (process / "artifacts").mkdir(parents=True)
+                (process / "session.json").write_text("{}\n", encoding="utf-8")
+                (process / "artifacts" / "one.dex.raw").write_bytes(b"dex")
+
+        with tempfile.TemporaryDirectory() as directory:
+            root = Path(directory)
+            destination = root / "run-with-exact-name"
+            candidate = export_latest.RunCandidate(
+                latest_artifact_mtime=1,
+                artifact_count=1,
+                remote_path="/remote/run-with-exact-name",
+            )
+            client = FakeClient()
+
+            export_latest.pull_run(client, candidate, destination)
+
+            self.assertEqual("/remote/run-with-exact-name/.", client.remote)
+            self.assertEqual("run-with-exact-name", client.local.name)
+            self.assertTrue((destination / "process-42/session.json").is_file())
+
+    def test_repairs_each_process_with_existing_host_repair(self) -> None:
+        with tempfile.TemporaryDirectory() as directory:
+            run = Path(directory) / "run"
+            process = run / "process-42"
+            (process / "records").mkdir(parents=True)
+            (process / "artifacts").mkdir()
+            (process / "session.json").write_text("{}\n", encoding="utf-8")
+            (process / "artifacts" / "000001.buffer.raw").write_bytes(b"not-a-dex")
+            (process / "records" / "000001.json").write_text(
+                json.dumps(
+                    {
+                        "capture_kind": "buffer",
+                        "artifact_relative_path": "artifacts/000001.buffer.raw",
+                    }
+                ),
+                encoding="utf-8",
+            )
+
+            reports = export_latest.repair_export(run)
+
+            self.assertEqual(1, len(reports))
+            self.assertEqual("ok", reports[0]["status"])
+            self.assertEqual(0, reports[0]["summary"]["verified"])
+            self.assertEqual(0, reports[0]["summary"]["repaired"])
+            self.assertEqual(1, reports[0]["summary"]["partial"])
+            self.assertEqual(0, reports[0]["summary"]["usable_outputs"])
+            self.assertEqual(
+                {"missing_dex_magic": 1}, reports[0]["summary"]["partial_reasons"]
+            )
+            report = run / reports[0]["report"]
+            self.assertTrue(report.is_file())
+            self.assertEqual("missing_dex_magic", json.loads(report.read_text())["records"][0]["reason"])
+
+    def test_missing_process_is_an_error(self) -> None:
+        with tempfile.TemporaryDirectory() as directory:
+            with self.assertRaises(export_latest.ExportError):
+                export_latest.repair_export(Path(directory))
+
+    def test_optional_tool_must_be_executable(self) -> None:
+        self.assertTrue(Path(export_latest.resolve_optional_tool(sys.executable, "python")).is_absolute())
+        with tempfile.TemporaryDirectory() as directory:
+            not_executable = Path(directory) / "tool"
+            not_executable.write_text("tool", encoding="utf-8")
+            with self.assertRaises(export_latest.ExportError):
+                export_latest.resolve_optional_tool(str(not_executable), "test tool")
+
+    def test_summary_counts_missing_artifact_as_partial(self) -> None:
+        summary = export_latest.repair_summary(
+            {
+                "records": [
+                    {"trust": "verified", "output": "repaired/a.dex"},
+                    {
+                        "trust": "repaired",
+                        "output": "repaired/b.dex",
+                        "output_kind": "codeitem_backfill",
+                    },
+                    {"trust": "partial"},
+                    {
+                        "status": "partial",
+                        "reason": "capture_dropped",
+                        "drop_reason": "pool_unavailable",
+                    },
+                ],
+                "reconstructions": [{"output": "repaired/b.dex"}],
+            }
+        )
+        self.assertEqual(1, summary["verified"])
+        self.assertEqual(1, summary["repaired"])
+        self.assertEqual(2, summary["partial"])
+        self.assertEqual(2, summary["usable_outputs"])
+        self.assertEqual(1, summary["codeitems_backfilled"])
+        self.assertEqual(1, summary["reconstructed_dex"])
+        self.assertEqual(
+            {"capture_dropped:pool_unavailable": 1, "unspecified": 1},
+            summary["partial_reasons"],
+        )
+
+    def test_archive_contains_run_and_has_sha256_sidecar(self) -> None:
+        with tempfile.TemporaryDirectory() as directory:
+            root = Path(directory)
+            run = root / "com.example.app" / "run-1"
+            (run / "process-1" / "artifacts").mkdir(parents=True)
+            (run / "export-report.json").write_text("{}\n", encoding="utf-8")
+            (run / "process-1" / "artifacts" / "one.dex.raw").write_bytes(b"dex")
+            archive = run.parent / "run-1.zip"
+
+            archive_path, checksum_path = export_latest.create_archive(
+                run, "com.example.app", archive
+            )
+
+            self.assertTrue(archive_path.is_file())
+            self.assertEqual(
+                f"{export_latest.sha256_file(archive)}  run-1.zip\n",
+                checksum_path.read_text(encoding="utf-8"),
+            )
+            with zipfile.ZipFile(archive) as value:
+                self.assertEqual(
+                    [
+                        "com.example.app/run-1/export-report.json",
+                        "com.example.app/run-1/process-1/artifacts/one.dex.raw",
+                    ],
+                    sorted(value.namelist()),
+                )
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/packages/apps/R0dumpManager/tools/validate_post_flash.sh b/packages/apps/R0dumpManager/tools/validate_post_flash.sh
