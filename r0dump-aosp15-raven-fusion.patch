+#include "r0dump/r0dump_hook_point.h"
+
+#include <set>
+
+#include "gtest/gtest.h"
+
+namespace art HIDDEN {
+namespace {
+
+TEST(r0dump_HookPointTest, DefinedPointsHaveUniqueOneBitMasks) {
+  std::set<r0dump_CapturePointMask> masks;
+  for (uint8_t index = 0; index < kR0dumpPointCount; ++index) {
+    const auto point = static_cast<r0dump_Point>(index);
+    const r0dump_CapturePointMask mask = r0dump_PointBit(point);
+    EXPECT_NE(mask, 0u);
+    EXPECT_EQ(mask & (mask - 1), 0u);
+    EXPECT_TRUE(masks.insert(mask).second);
+  }
+  EXPECT_EQ(masks.size(), kR0dumpPointCount);
+  EXPECT_EQ(kR0dumpDefinedPointMask, (r0dump_CapturePointMask{1} << kR0dumpPointCount) - 1);
+}
+
+TEST(r0dump_HookPointTest, NamesRoundTripForEveryDefinedPoint) {
+  for (uint8_t index = 0; index < kR0dumpPointCount; ++index) {
+    const auto point = static_cast<r0dump_Point>(index);
+    const std::string_view name = r0dump_PointName(point);
+    ASSERT_FALSE(name.empty());
+    const std::optional<r0dump_Point> resolved = r0dump_PointFromName(name);
+    ASSERT_TRUE(resolved.has_value());
+    EXPECT_EQ(*resolved, point);
+  }
+  EXPECT_EQ(r0dump_PointName(static_cast<r0dump_Point>(kR0dumpPointCount)), "");
+  EXPECT_FALSE(r0dump_PointFromName("Walk.inventory").has_value());
+  EXPECT_FALSE(r0dump_PointFromName("ForceInvoke.request").has_value());
+}
+
+TEST(r0dump_HookPointTest, RejectsUndefinedMaskBits) {
+  EXPECT_TRUE(r0dump_IsDefinedPointMask(0));
+  EXPECT_TRUE(r0dump_IsDefinedPointMask(kR0dumpDefinedPointMask));
+  EXPECT_FALSE(r0dump_IsDefinedPointMask(r0dump_CapturePointMask{1} << kR0dumpPointCount));
+  EXPECT_FALSE(r0dump_IsDefinedPointMask(~kR0dumpDefinedPointMask));
+  EXPECT_EQ(r0dump_PointBit(static_cast<r0dump_Point>(kR0dumpPointCount)), 0u);
+}
+
+TEST(r0dump_HookPointTest, ForceInvokeUsesBit41) {
+  EXPECT_EQ(r0dump_PointIndex(r0dump_Point::kForceInvokeNoExecute), 41u);
+  EXPECT_EQ(r0dump_PointBit(r0dump_Point::kForceInvokeNoExecute), r0dump_CapturePointMask{1} << 41);
+  EXPECT_EQ(r0dump_PointName(r0dump_Point::kForceInvokeNoExecute), "ForceInvoke.no_execute");
+}
+
+TEST(r0dump_HookPointTest, EnabledCheckRejectsUndefinedPoints) {
+  const r0dump_CapturePointMask mask = r0dump_PointBit(r0dump_Point::kOpenCommonReturn);
+  EXPECT_TRUE(r0dump_IsCapturePointEnabled(mask, r0dump_Point::kOpenCommonReturn));
+  EXPECT_FALSE(r0dump_IsCapturePointEnabled(mask, r0dump_Point::kCookieResultDex));
+  EXPECT_FALSE(r0dump_IsCapturePointEnabled(~r0dump_CapturePointMask{0},
+                                            static_cast<r0dump_Point>(kR0dumpPointCount)));
+}
+
+}  // namespace
+}  // namespace art HIDDEN
diff --git a/art/runtime/r0dump/r0dump_jni_contract_test.py b/art/runtime/r0dump/r0dump_jni_contract_test.py
new file mode 100644
--- /dev/null
+++ b/art/runtime/r0dump/r0dump_jni_contract_test.py
@@ -0,0 +1,53 @@
+#!/usr/bin/env python3
+"""Compare compiled Java native descriptors with the actual ART registration table."""
+from pathlib import Path
+import os
+import re
+import shutil
+import subprocess
+import tempfile
+
+TOP = Path(__file__).resolve().parents[3]
+JAVA = TOP / 'libcore/libart/src/main/java/dalvik/system/r0dump_Runtime.java'
+NATIVE = TOP / 'art/runtime/native/dalvik_system_r0dump_Runtime.cc'
+
+def main():
+    jdk = TOP / 'prebuilts/jdk/jdk21/linux-x86/bin'
+    javac = str(jdk / 'javac') if (jdk / 'javac').exists() else shutil.which('javac')
+    javap = str(jdk / 'javap') if (jdk / 'javap').exists() else shutil.which('javap')
+    assert javac and javap, 'JDK required to verify descriptors'
+    native = NATIVE.read_text().split('static JNINativeMethod gMethods[] = {', 1)[1]
+    expected = {}
+    for name, strings in re.findall(r'NATIVE_METHOD\(\s*r0dump_Runtime,\s*(\w+),\s*((?:"[^"]*"\s*)+)\)', native):
+        expected[name] = ''.join(re.findall(r'"([^"]*)"', strings))
+    assert expected, 'No native registrations found'
+    with tempfile.TemporaryDirectory(prefix='r0dump-jni-') as directory:
+        temp = Path(directory)
+        package = temp / 'dalvik/system'
+        package.mkdir(parents=True)
+        shutil.copy2(JAVA, package / JAVA.name)
+        # The cookie helper is the sole Android-only dependency of this Java bridge.
+        (package / 'BaseDexClassLoader.java').write_text('''package dalvik.system;
+class BaseDexClassLoader {
+ static Object[] r0dump_GetDexCookies(ClassLoader loader) { return null; }
+ static Object[] r0dump_GetDexCookies(ClassLoader loader, int first) { return null; }
+}
+''')
+        annotation = temp / 'android/annotation'
+        annotation.mkdir(parents=True)
+        (annotation / 'SystemApi.java').write_text('package android.annotation; '
+            'public @interface SystemApi { Client client(); '
+            'enum Client { MODULE_LIBRARIES } }')
+        subprocess.run([javac, '-d', str(temp), *map(str, temp.rglob('*.java'))], check=True)
+        dump = subprocess.check_output([javap, '-p', '-s', '-classpath', str(temp),
+                                       'dalvik.system.r0dump_Runtime'], text=True)
+        actual = {}
+        for declaration, descriptor in re.findall(r'([^\n]+);\n\s*descriptor: ([^\n]+)', dump):
+            if ' native ' in declaration:
+                name = declaration.split('(')[0].split()[-1]
+                actual[name] = descriptor.strip()
+        assert actual == expected, f'JNI ABI mismatch:\nJava={actual}\nNative={expected}'
+        print(f'PASS: {len(actual)} compiled Java native descriptors match ART')
+
+if __name__ == '__main__':
+    main()
diff --git a/art/runtime/r0dump/r0dump_log.cc b/art/runtime/r0dump/r0dump_log.cc
new file mode 100644
--- /dev/null
+++ b/art/runtime/r0dump/r0dump_log.cc
@@ -0,0 +1,207 @@
+/*
+ * Copyright (C) 2026 The Android Open Source Project
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
