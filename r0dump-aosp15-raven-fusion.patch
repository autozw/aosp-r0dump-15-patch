+                          size_t max_artifacts,
+                          size_t max_total_bytes,
+                          size_t max_frozen_generations = kR0dumpMaxFrozenGenerationsHardLimit,
+                          uint64_t flush_idle_ns = kR0dumpDefaultFlushIdleNs);
+  ~r0dump_Staging();
+
+  r0dump_Staging(const r0dump_Staging&) = delete;
+  r0dump_Staging& operator=(const r0dump_Staging&) = delete;
+
+  r0dump_SubmitResult r0dump_SubmitDex(r0dump_CaptureKind capture_kind,
+                                       r0dump_DexFormat dex_format,
+                                       std::unique_ptr<r0dump_OwnedCapture> capture,
+                                       const r0dump_HookContext& context,
+                                       r0dump_RecordMetadata&& metadata = {});
+  std::optional<r0dump_SubmitResult> r0dump_TryReferenceDex(
+      r0dump_CaptureKind capture_kind,
+      r0dump_DexFormat dex_format,
+      const uint8_t* data,
+      size_t size,
+      uint64_t hash,
+      const r0dump_HookContext& context,
+      const r0dump_RecordMetadata& metadata = {});
+  r0dump_SubmitResult r0dump_TryReferenceDexOrMetadata(r0dump_CaptureKind capture_kind,
+                                                       r0dump_DexFormat dex_format,
+                                                       const uint8_t* data,
+                                                       size_t size,
+                                                       uint64_t hash,
+                                                       const r0dump_HookContext& context,
+                                                       r0dump_RecordMetadata metadata = {});
+  r0dump_SubmitResult r0dump_SubmitCodeItem(r0dump_CodeItemKey key,
+                                            std::unique_ptr<r0dump_OwnedCapture> capture,
+                                            r0dump_CodeItemMetadata&& metadata,
+                                            const r0dump_HookContext& context,
+                                            r0dump_RecordMetadata&& record_metadata = {});
+  r0dump_SubmitResult r0dump_RecordDrop(const r0dump_HookContext& context,
+                                        r0dump_CaptureKind capture_kind,
+                                        r0dump_DexFormat dex_format,
+                                        std::string_view reason,
+                                        r0dump_RecordMetadata metadata = {});
+  r0dump_SubmitResult r0dump_SubmitMetadata(const r0dump_HookContext& context,
+                                            r0dump_RecordMetadata metadata = {});
+  r0dump_SubmitResult r0dump_TrySubmitMetadata(const r0dump_HookContext& context,
+                                               r0dump_RecordMetadata metadata = {});
+  bool r0dump_ShouldFlush(uint64_t now_ns, bool force_completion) const;
+  r0dump_ActiveFlushState r0dump_GetActiveFlushState() const;
+  r0dump_FreezeResult r0dump_TryFreeze(bool try_lock = false);
+  bool r0dump_ReleaseFrozen(uint64_t generation_id);
+  size_t r0dump_FrozenCount() const;
+  size_t r0dump_DexCount() const;
+  size_t r0dump_CodeItemCount() const;
+  size_t r0dump_RecordCount() const;
+  size_t r0dump_ArtifactCount() const;
+  size_t r0dump_AdmittedBytes() const;
+  r0dump_BufferSummary r0dump_GetSummary() const;
+  bool r0dump_GetSummary(r0dump_BufferSummary* summary, bool try_lock) const;
+
+ private:
+  ART_FRIEND_TEST(r0dump_BufferTest, TrySummaryDoesNotWaitForStagingLock);
+  ART_FRIEND_TEST(r0dump_BufferTest, SubmissionPathsDoNotWaitForStagingLock);
+  ART_FRIEND_TEST(r0dump_CaptureTest, ProductionFacadeGatesAndDeduplicatesOpenCommonObservations);
+
+  bool r0dump_IsValidContext(const r0dump_HookContext& context) const;
+  uint64_t r0dump_AppendRecordLocked(const r0dump_HookContext& context,
+                                     r0dump_CaptureKind capture_kind,
+                                     r0dump_DexFormat dex_format,
+                                     r0dump_RecordStatus status,
+                                     uint64_t payload_id,
+                                     std::optional<uint64_t> duplicate_of,
+                                     std::string_view drop_reason,
+                                     r0dump_RecordMetadata&& metadata);
+  std::optional<r0dump_SubmitResult> r0dump_TryReferenceDexLocked(
+      const r0dump_DexBlobKey& key,
+      const uint8_t* data,
+      size_t size,
+      const r0dump_HookContext& context,
+      const r0dump_RecordMetadata& metadata);
+  r0dump_SubmitResult r0dump_SubmitMetadataLocked(const r0dump_HookContext& context,
+                                                  r0dump_RecordMetadata metadata);
+
+  mutable std::mutex lock_;
+  std::shared_ptr<r0dump_BufferPool> pool_;
+  std::unique_ptr<r0dump_PendingDexMap> active_dex_;
+  std::unique_ptr<r0dump_PendingCodeItemMap> active_code_items_;
+  std::unique_ptr<r0dump_PendingRecordList> active_records_;
+  size_t max_active_entries_;
+  size_t max_records_;
+  size_t max_artifacts_;
+  size_t max_total_bytes_;
+  size_t max_frozen_generations_;
+  uint64_t flush_idle_ns_;
+  size_t active_entries_ = 0;
+  size_t run_records_ = 0;
+  size_t run_artifacts_ = 0;
+  size_t run_bytes_ = 0;
+  size_t active_pending_bytes_ = 0u;
+  size_t pending_entries_high_water_ = 0u;
+  size_t pending_bytes_high_water_ = 0u;
+  size_t flush_watermark_bytes_ = 0u;
+  uint64_t last_activity_ns_ = 0u;
+  bool watermark_latched_ = false;
+  size_t frozen_count_ = 0;
+  size_t frozen_generations_high_water_ = 0u;
+  uint64_t next_generation_id_ = 1;
+  uint64_t next_record_sequence_ = 1;
+  uint64_t next_payload_id_ = 1;
+  std::array<uint64_t, kR0dumpMaxFrozenGenerationsHardLimit> frozen_ids_ = {};
+  std::array<r0dump_PointOutcomeCounters, kR0dumpPointCount> point_outcomes_ = {};
+};
+
+}  // namespace art HIDDEN
