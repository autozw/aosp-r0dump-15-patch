+
+package com.android.server.am;
+
+import static com.google.common.truth.Truth.assertThat;
+import static org.junit.Assert.assertThrows;
+
+import java.io.IOException;
+import java.nio.ByteBuffer;
+import java.nio.ByteOrder;
+import java.nio.charset.StandardCharsets;
+import org.junit.Test;
+
+public class r0dump_FilePreparationBridgeTest {
+  @Test
+  public void encodeRequest_hasStableLittleEndianLayoutAndZeroPadding() throws Exception {
+    final byte[] request =
+        r0dump_FilePreparationBridge.encodeRequest(
+            10198, 2468, "com.coolapk.market", "com.coolapk.market:push", "run-1", 278L);
+
+    assertThat(request).hasLength(285);
+    final ByteBuffer buffer = ByteBuffer.wrap(request).order(ByteOrder.LITTLE_ENDIAN);
+    assertThat(buffer.getInt()).isEqualTo(0x52304648);
+    assertThat(buffer.getShort()).isEqualTo((short) 1);
+    assertThat(Short.toUnsignedInt(buffer.getShort())).isEqualTo(285);
+    assertThat(buffer.getLong()).isEqualTo(278L);
+    assertThat(buffer.getInt()).isEqualTo(0);
+    assertThat(buffer.getInt()).isEqualTo(10198);
+    assertThat(buffer.getInt()).isEqualTo(2468);
+
+    final byte[] packageBytes = new byte[96];
+    buffer.get(packageBytes);
+    assertThat(new String(packageBytes, 0, "com.coolapk.market".length(), StandardCharsets.UTF_8))
+        .isEqualTo("com.coolapk.market");
+    assertThat(packageBytes["com.coolapk.market".length()]).isEqualTo((byte) 0);
+  }
+
+  @Test
+  public void encodeRequest_rejectsOddGenerationAndOversizedField() {
+    assertThrows(
+        IOException.class,
+        () ->
+            r0dump_FilePreparationBridge.encodeRequest(
+                10198, 2468, "com.coolapk.market", "com.coolapk.market", "run", 3L));
+    assertThrows(
+        IOException.class,
+        () ->
+            r0dump_FilePreparationBridge.encodeRequest(
+                10198, 2468, "a".repeat(96), "process", "run", 4L));
+  }
+
+  @Test
+  public void encodeRequest_acceptsSystemUid() throws Exception {
+    final byte[] request =
+        r0dump_FilePreparationBridge.encodeRequest(
+            1000, 2468, "com.android.settings", "com.android.settings", "run", 4L);
+
+    final ByteBuffer buffer = ByteBuffer.wrap(request).order(ByteOrder.LITTLE_ENDIAN);
+    buffer.position(16);
+    assertThat(buffer.getInt()).isEqualTo(0);
+    assertThat(buffer.getInt()).isEqualTo(1000);
+    assertThat(buffer.getInt()).isEqualTo(2468);
+  }
+
+  @Test
+  public void encodeExportRequest_hasStableLayoutAndApkCount() throws Exception {
+    final byte[] request =
+        r0dump_FilePreparationBridge.encodeExportRequest(10195, "com.example.target", 3);
+
+    assertThat(request).hasLength(116);
+    final ByteBuffer buffer = ByteBuffer.wrap(request).order(ByteOrder.LITTLE_ENDIAN);
+    assertThat(buffer.getInt()).isEqualTo(0x52304558);
+    assertThat(buffer.getShort()).isEqualTo((short) 1);
+    assertThat(Short.toUnsignedInt(buffer.getShort())).isEqualTo(116);
+    assertThat(buffer.getInt()).isEqualTo(0);
+    assertThat(buffer.getInt()).isEqualTo(10195);
+    assertThat(buffer.getInt()).isEqualTo(3);
+    final byte[] packageBytes = new byte[96];
+    buffer.get(packageBytes);
+    assertThat(new String(packageBytes, 0, "com.example.target".length(), StandardCharsets.UTF_8))
+        .isEqualTo("com.example.target");
+  }
+
+  @Test
+  public void encodeExportRequest_acceptsSystemUid() throws Exception {
+    final byte[] request =
+        r0dump_FilePreparationBridge.encodeExportRequest(1000, "com.android.settings", 1);
+
+    final ByteBuffer buffer = ByteBuffer.wrap(request).order(ByteOrder.LITTLE_ENDIAN);
+    buffer.position(8);
+    assertThat(buffer.getInt()).isEqualTo(0);
+    assertThat(buffer.getInt()).isEqualTo(1000);
+    assertThat(buffer.getInt()).isEqualTo(1);
+  }
+
+  @Test
+  public void encodeRequest_rejectsZeroUid() {
+    assertThrows(
+        IOException.class,
+        () ->
+            r0dump_FilePreparationBridge.encodeRequest(
+                0, 2468, "com.android.settings", "com.android.settings", "run", 4L));
+  }
+
+  @Test
+  public void encodeExportRequest_rejectsZeroUid() {
+    assertThrows(
+        IOException.class,
+        () -> r0dump_FilePreparationBridge.encodeExportRequest(0, "com.android.settings", 1));
+  }
+}
