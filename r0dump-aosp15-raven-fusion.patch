+  constexpr std::array<std::string_view, 5u> kR0dumpArtifactKinds = {
+      "dex", "buffer", "dexdata", "codeitem", "metadata"};
+  bool artifact_first = true;
+  for (size_t index = 0u; index != kR0dumpArtifactKinds.size(); ++index) {
