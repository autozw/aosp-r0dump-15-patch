+          "force_class",
+          "force_method",
+          "force_method_descriptor",
+          "force_max_calls",
+          "anr_protection_enabled");
+
+  final int schema;
+  final boolean enabled;
+  final String runId;
+  final String targetPackage;
+  final String targetProcess;
+  final long capturePointMask;
+  final long maxRecords;
+  final long maxArtifacts;
+  final long maxTotalBytes;
+  final long maxDexBytes;
+  final long bufferPoolBytes;
+  final long maxCodeItemBytes;
+  final long maxFrozenGenerations;
+  final long flushIdleMs;
+  final boolean manifestEnabled;
+  final boolean manifestIncludeSplits;
+  final long manifestMaxComponents;
+  final long manifestMaxSplits;
+  final long manifestMaxEventsPerSource;
+  final long manifestMaxTotalEvents;
+  final long manifestMaxXmlDepth;
+  final long manifestMaxAttributeLength;
+  final boolean walkEnabled;
+  final int walkStart;
+  final int walkMode;
+  final String walkNamespacePrefix;
+  final long walkDelayMs;
+  final long walkMaxClasses;
+  final long walkMaxMethods;
+  final boolean forceInvokeEnabled;
+  final String forceClass;
+  final String forceMethod;
+  final String forceMethodDescriptor;
+  final long forceMaxCalls;
+  final boolean anrProtectionEnabled;
+  private long persistedGeneration = -1L;
+
+  private r0dump_FusionConfig(JSONObject json) throws JSONException {
+    schema = r0dump_requireInt(json, "schema");
+    enabled = r0dump_requireBoolean(json, "enabled");
+    runId = r0dump_requireString(json, "run_id");
+    targetPackage = r0dump_requireString(json, "target_package");
+    targetProcess = r0dump_requireString(json, "target_process");
+    capturePointMask = r0dump_parseMask(r0dump_requireString(json, "capture_point_mask"));
+    maxRecords = r0dump_requireUnsignedInt(json, "max_records");
+    maxArtifacts = r0dump_requireUnsignedInt(json, "max_artifacts");
+    maxTotalBytes = r0dump_requirePositiveLong(json, "max_total_bytes");
+    maxDexBytes = r0dump_requirePositiveLong(json, "max_dex_bytes");
+    bufferPoolBytes = r0dump_requirePositiveLong(json, "buffer_pool_bytes");
+    maxCodeItemBytes = r0dump_requirePositiveLong(json, "max_code_item_bytes");
+    maxFrozenGenerations = r0dump_requireUnsignedInt(json, "max_frozen_generations");
+    flushIdleMs = r0dump_requireUnsignedInt(json, "flush_idle_ms");
+    manifestEnabled = r0dump_requireBoolean(json, "manifest_enabled");
+    manifestIncludeSplits = r0dump_requireBoolean(json, "manifest_include_splits");
+    manifestMaxComponents = r0dump_requireUnsignedInt(json, "manifest_max_components");
+    manifestMaxSplits = r0dump_requireUnsignedInt(json, "manifest_max_splits");
+    manifestMaxEventsPerSource = r0dump_requireUnsignedInt(json, "manifest_max_events_per_source");
+    manifestMaxTotalEvents = r0dump_requireUnsignedInt(json, "manifest_max_total_events");
+    manifestMaxXmlDepth = r0dump_requireUnsignedInt(json, "manifest_max_xml_depth");
+    manifestMaxAttributeLength = r0dump_requireUnsignedInt(json, "manifest_max_attribute_length");
+    walkEnabled = r0dump_requireBoolean(json, "walk_enabled");
+    walkStart = r0dump_parseWalkStart(r0dump_requireString(json, "walk_start"));
+    walkMode = r0dump_parseWalkMode(r0dump_requireString(json, "walk_mode"));
+    walkNamespacePrefix = r0dump_requireString(json, "walk_namespace_prefix");
+    walkDelayMs = r0dump_requireUnsignedInt(json, "walk_delay_ms");
+    walkMaxClasses = r0dump_requireUnsignedInt(json, "walk_max_classes");
+    walkMaxMethods = r0dump_requireUnsignedInt(json, "walk_max_methods");
+    forceInvokeEnabled = r0dump_requireBoolean(json, "force_invoke_enabled");
+    forceClass = r0dump_requireString(json, "force_class");
+    forceMethod = r0dump_requireString(json, "force_method");
+    forceMethodDescriptor = r0dump_requireString(json, "force_method_descriptor");
+    forceMaxCalls = r0dump_requireUnsignedInt(json, "force_max_calls");
+    anrProtectionEnabled = r0dump_requireBoolean(json, "anr_protection_enabled");
+    r0dump_validate();
+  }
+
+  static r0dump_FusionConfig r0dump_configureForApp(
+      Context appContext, String packageName, String processName) {
+    if (!r0dump_isSystemUserUid(Process.myUid())) {
+      return null;
+    }
+    final r0dump_FusionConfig config;
+    try {
+      config = r0dump_readPersisted(SYSTEM_PROPERTIES);
+    } catch (RuntimeException e) {
+      Slog.w(TAG, "Unable to read process configuration", e);
+      return null;
+    }
+    if (config == null) {
+      return null;
+    }
+    if (!config.enabled || !config.r0dump_matchesProcess(packageName, processName)) {
+      return null;
+    }
+
+    final String outputParent = r0dump_getOutputParent(appContext);
+    if (outputParent == null) {
+      Slog.w(TAG, "Application external files directory is unavailable");
+      return null;
+    }
+    try (ParcelFileDescriptor deliveryChannel =
+        ActivityManager.getService()
+            .r0dump_prepareOutput(
+                packageName, processName, config.runId, config.persistedGeneration)) {
+      if (deliveryChannel == null) {
+        Slog.w(TAG, "Output directory preparation was rejected");
+        return null;
+      }
+      try (ParcelFileDescriptor preparedDirectory =
+          r0dump_receivePreparedDirectory(deliveryChannel)) {
+        if (!r0dump_publishIfEnabled(
+            config,
+            packageName,
+            processName,
+            outputParent,
+            preparedDirectory.getFd(),
+            r0dump_FusionConfig::r0dump_publishNative)) {
+          Slog.w(TAG, "Native process configuration was rejected");
+          return null;
+        }
+      }
+    } catch (IOException | RemoteException e) {
+      Slog.w(TAG, "Unable to prepare the output directory", e);
+      return null;
+    }
+    return config;
+  }
+
+  private static ParcelFileDescriptor r0dump_receivePreparedDirectory(
+      ParcelFileDescriptor deliveryChannel) throws IOException {
+    final LocalSocket socket = new LocalSocket(deliveryChannel.getFileDescriptor());
+    if (socket.getInputStream().read() != 1) {
+      throw new IOException("invalid directory delivery response");
+    }
+    final FileDescriptor[] received = socket.getAncillaryFileDescriptors();
+    try {
+      if (received == null || received.length != 1) {
+        throw new IOException("invalid directory descriptor count");
+      }
+      return ParcelFileDescriptor.dup(received[0]);
+    } finally {
+      if (received != null) {
+        for (FileDescriptor descriptor : received) {
+          try {
+            android.system.Os.close(descriptor);
+          } catch (android.system.ErrnoException ignored) {
+          }
+        }
+      }
+    }
+  }
