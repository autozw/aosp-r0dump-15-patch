+std::string CreateCapturedProcess(const std::string& root) {
+  const std::string process = root +
+      "/Android/data/com.example.target/files/r0dump-fusion/runs/run-1/process-1234";
+  std::filesystem::create_directories(process + "/artifacts");
+  std::filesystem::create_directories(process + "/records");
+  std::ofstream(process + "/session.json") << "{}\n";
+  return process;
+}
+
+int CreateFixtureApk(const std::string& root) {
+  const std::string path = root + "/base.apk";
+  FILE* file = fopen(path.c_str(), "wb");
+  if (file == nullptr) return -1;
+  ZipWriter writer(file);
+  bool ok = writer.StartEntry("AndroidManifest.xml", 0) == 0;
+  constexpr char manifest[] = "fixture-manifest";
+  ok = ok && writer.WriteBytes(manifest, sizeof(manifest) - 1u) == 0;
+  ok = ok && writer.FinishEntry() == 0 && writer.Finish() == 0;
+  ok = fclose(file) == 0 && ok;
+  return ok ? open(path.c_str(), O_RDONLY | O_CLOEXEC) : -1;
+}
