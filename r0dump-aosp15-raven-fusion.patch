+++ b/art/runtime/r0dump/r0dump_f9_reflect_instrument_source_test.py
@@ -0,0 +1,173 @@
+#!/usr/bin/env python3
+
+from pathlib import Path
+
+
+ART = Path(__file__).resolve().parents[2]
+
+
+def r0dump_read(relative: str) -> str:
+    return (ART / relative).read_text(encoding="utf-8")
+
+
+def r0dump_between(source: str, begin: str, end: str) -> str:
+    start = source.index(begin)
+    finish = source.index(end, start + len(begin))
+    return source[start:finish]
+
+
+def r0dump_assert_no_io_or_control(source: str) -> None:
+    for forbidden in (
+        "r0dump_Write",
+        "open(",
+        "write(",
+        "fsync(",
+        "EnsureInitialized",
+        "ScopedSuspendAll",
+        "MutexLock",
+        "AddListener",
+        "RemoveListener",
+        "std::thread",
+    ):
+        assert forbidden not in source, forbidden
+
+
+def r0dump_check_capture_roles() -> None:
+    header = r0dump_read("runtime/r0dump/r0dump_capture.h")
+    source = r0dump_read("runtime/r0dump/r0dump_capture.cc")
+    assert "kReflectMethod" in header
+    assert "kReflectConstructor" in header
+    assert 'return "reflect_method";' in source
+    assert 'return "reflect_constructor";' in source
+
+
+def r0dump_check_reflect_method() -> None:
+    source = r0dump_read("runtime/native/java_lang_reflect_Method.cc")
+    body = r0dump_between(source, "static jobject Method_invoke(", "static JNINativeMethod gMethods")
+    resolved = "ArtMethod* method = ArtMethod::FromReflectedMethod(soa, javaMethod);"
+    fast_gate = "r0dump_IsCapturePointActiveFast"
+    observer = "r0dump_ObserveMethodCodeItem("
+    invoke = "return InvokeMethod<kRuntimePointerSize>"
+    assert body.count(observer) == 1
+    assert body.count("r0dump_Point::kReflectMethodBeforeInvoke") == 2
+    assert "r0dump_CodeItemRole::kReflectMethod" in body
+    assert '"Reflect.method.before_invoke"' in body
+    assert body.index(fast_gate) < body.index(resolved) < body.index(observer) < body.index(invoke)
+    assert body.count(invoke) == 1
+    hook = body[body.index(fast_gate) : body.index(invoke)]
+    assert "javaReceiver" not in hook
+    assert "javaArgs" not in hook
+    r0dump_assert_no_io_or_control(hook)
+
+
+def r0dump_check_reflect_constructor() -> None:
+    source = r0dump_read("runtime/native/java_lang_reflect_Constructor.cc")
+    body = r0dump_between(
+        source,
+        "static jobject Constructor_newInstance0(",
+        "static jobject Constructor_newInstanceFromSerialization",
+    )
+    resolved = "ArtMethod* constructor_art_method = m->GetArtMethod();"
+    fast_gate = "r0dump_IsCapturePointActiveFast"
+    observer = "r0dump_ObserveMethodCodeItem("
+    string_invoke = "return InvokeMethod<kRuntimePointerSize>"
+    normal_invoke = "InvokeConstructor(soa, constructor_art_method"
+    assert body.count(observer) == 1
+    assert body.count("r0dump_Point::kReflectCtorBeforeInvoke") == 2
+    assert "r0dump_CodeItemRole::kReflectConstructor" in body
+    assert '"Reflect.ctor.before_invoke"' in body
+    assert body.index(resolved) < body.index(fast_gate) < body.index(observer)
+    assert body.index(observer) < body.index(string_invoke)
+    assert body.index(observer) < body.index(normal_invoke)
+    hook = body[body.index(fast_gate) : body.index("StackHandleScope<1>")]
+    assert "javaArgs" not in hook
+    assert "receiver" not in hook
+    r0dump_assert_no_io_or_control(hook)
+
+
+def r0dump_check_instrumentation() -> None:
+    capture = r0dump_read("runtime/r0dump/r0dump_capture.cc")
+    helper = r0dump_between(
+        capture,
+        "void r0dump_ObserveInstrumentationMethodEvent(",
+        "r0dump_JitCompileAttempt::r0dump_JitCompileAttempt",
+    )
+    assert 'metadata.source_kind = "instrumentation";' in helper
+    assert "metadata.dispatch_status = dispatch_status;" in helper
+    assert "r0dump_TryObserveMethodMetadata(" in helper
+    assert "r0dump_ObserveMethodMetadata(" not in helper
+    r0dump_assert_no_io_or_control(helper)
+
+    source = r0dump_read("runtime/instrumentation.cc")
+    prefix = r0dump_between(source, "namespace instrumentation {", "void InstrumentationListener::MethodExited(")
+    assert "r0dump_ObserveInstrumentationMethodEvent" not in prefix
+
+    enter = r0dump_between(
+        source,
+        "void Instrumentation::MethodEnterEventImpl(",
+        "template <>\nvoid Instrumentation::MethodExitEventImpl(",
+    )
+    assert enter.count("r0dump_Point::kInstrumentationEnter") == 2
+    assert '"Instrumentation.enter"' in enter
+    assert enter.index("DCHECK(!method->IsRuntimeMethod())") < enter.index(
+        "r0dump_IsCapturePointActiveFast"
+    )
+    assert enter.index("r0dump_ObserveInstrumentationMethodEvent") < enter.index(
+        "if (HasMethodEntryListeners())"
+    )
+
+    enter_start = source.index("void Instrumentation::MethodEnterEventImpl(")
+    object_start = source.index(
+        "template <>\nvoid Instrumentation::MethodExitEventImpl(", enter_start
+    )
+    value_start = source.index(
+        "template<> void Instrumentation::MethodExitEventImpl(", object_start
+    )
+    unwind_start = source.index("void Instrumentation::MethodUnwindEvent(", value_start)
+    object_exit = source[object_start:value_start]
+    assert object_exit.count("r0dump_Point::kInstrumentationExitObject") == 2
+    assert "kInstrumentationExitValue" not in object_exit
+    assert '"Instrumentation.exit.object"' in object_exit
+    assert object_exit.index("r0dump_ObserveInstrumentationMethodEvent") < object_exit.index(
+        "if (HasMethodExitListeners())"
+    )
+    hook = object_exit[
+        object_exit.index("r0dump_IsCapturePointActiveFast") : object_exit.index(
+            "if (HasMethodExitListeners())"
+        )
+    ]
+    assert "return_value" not in hook
+
+    value_exit = source[value_start:unwind_start]
+    predicate = "GetReturnTypePrimitive() !=\n        Primitive::kPrimNot"
+    assert value_exit.count("r0dump_Point::kInstrumentationExitValue") == 2
+    assert "kInstrumentationExitObject" not in value_exit
+    assert '"Instrumentation.exit.value"' in value_exit
+    assert value_exit.index(predicate) < value_exit.index("r0dump_IsCapturePointActiveFast")
+    assert value_exit.index("r0dump_ObserveInstrumentationMethodEvent") < value_exit.index(
+        "for (InstrumentationListener* listener"
+    )
+    value_hook = value_exit[
+        value_exit.index("r0dump_IsCapturePointActiveFast") : value_exit.index(
+            "for (InstrumentationListener* listener"
+        )
+    ]
+    assert "return_value" not in value_hook
+    r0dump_assert_no_io_or_control(enter)
+    r0dump_assert_no_io_or_control(object_exit)
+    r0dump_assert_no_io_or_control(value_hook)
+
+    header = r0dump_read("runtime/instrumentation.h")
+    public_gate = r0dump_between(
+        header,
+        "void MethodEnterEvent(Thread* thread",
+        "void MethodUnwindEvent(Thread* thread",
+    )
+    assert "r0dump" not in public_gate
+
+
+if __name__ == "__main__":
+    r0dump_check_capture_roles()
+    r0dump_check_reflect_method()
+    r0dump_check_reflect_constructor()
+    r0dump_check_instrumentation()
