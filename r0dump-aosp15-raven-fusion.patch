+    worker = r0dump_between(source, "class JitCompileTask final", "class JitProfileTask final")
+    profile = r0dump_between(
+        source,
+        "bool Jit::CompileMethodFromProfile(",
+        "uint32_t Jit::CompileMethodsFromBootProfile",
+    )
+    wrapper = r0dump_between(
+        source,
+        "bool Jit::CompileMethod(ArtMethod* method",
+        "size_t JitThreadPool::GetTaskCount",
+    )
+    # A15 merges kCompile and kPreCompile into one switch body.
+    assert worker.count("CompileMethodInternal(") == 1
+    assert "case TaskKind::kCompile:" in worker
+    assert "case TaskKind::kPreCompile:" in worker
+    assert profile.count("CompileMethodInternal(") == 1
+    assert wrapper.count("CompileMethodInternal(") == 1
