+struct r0dump_Segment final {
+  const uint8_t* data = nullptr;
+  size_t size = 0;
+};
+
+using r0dump_HashFunction = uint64_t (*)(const r0dump_Segment*, size_t);
+
+uint64_t r0dump_HashBytes(const uint8_t* data, size_t size);
+uint64_t r0dump_HashSegments(const r0dump_Segment* segments, size_t segment_count);
+
+class r0dump_BufferState;
+class r0dump_PreparedCapture;
+
+class r0dump_OwnedCapture final {
+ public:
+  r0dump_OwnedCapture(r0dump_OwnedCapture&& other) noexcept;
+  r0dump_OwnedCapture& operator=(r0dump_OwnedCapture&& other) noexcept;
+  ~r0dump_OwnedCapture();
+
+  r0dump_OwnedCapture(const r0dump_OwnedCapture&) = delete;
+  r0dump_OwnedCapture& operator=(const r0dump_OwnedCapture&) = delete;
+
+  size_t r0dump_Size() const { return size_; }
+  uint64_t r0dump_Hash() const { return hash_; }
+  size_t r0dump_SegmentCount() const { return chunk_count_; }
+  r0dump_Segment r0dump_GetSegment(size_t index) const;
+  bool r0dump_Equals(const r0dump_OwnedCapture& other) const;
+  bool r0dump_EqualsBytes(const uint8_t* data, size_t size, uint64_t hash) const;
+
+ private:
+  friend class r0dump_BufferPool;
+  friend class r0dump_PreparedCapture;
+  explicit r0dump_OwnedCapture(std::shared_ptr<r0dump_BufferState> state);
+  r0dump_OwnedCapture(std::shared_ptr<r0dump_BufferState> state,
+                      const uint16_t* chunks,
+                      size_t chunk_count,
+                      size_t size,
+                      uint64_t hash);
+  void r0dump_Release();
+
+  std::shared_ptr<r0dump_BufferState> state_;
+  std::array<uint16_t, kR0dumpMaxChunksPerCapture> chunks_ = {};
+  size_t chunk_count_ = 0;
+  size_t size_ = 0;
+  uint64_t hash_ = 0;
+};
+
+class r0dump_PreparedCapture final {
+ public:
+  r0dump_PreparedCapture() = default;
+  r0dump_PreparedCapture(r0dump_PreparedCapture&& other) noexcept;
+  r0dump_PreparedCapture& operator=(r0dump_PreparedCapture&& other) noexcept;
+  ~r0dump_PreparedCapture();
+
+  r0dump_PreparedCapture(const r0dump_PreparedCapture&) = delete;
+  r0dump_PreparedCapture& operator=(const r0dump_PreparedCapture&) = delete;
+
+  bool r0dump_IsReady() const { return state_ != nullptr; }
+  size_t r0dump_Size() const { return size_; }
+  uint64_t r0dump_Hash() const { return hash_; }
+  std::unique_ptr<r0dump_OwnedCapture> r0dump_Consume();
+
+ private:
+  friend class r0dump_BufferPool;
+  void r0dump_Release();
+
+  std::shared_ptr<r0dump_BufferState> state_;
+  std::array<uint16_t, kR0dumpMaxChunksPerCodeItem> chunks_ = {};
+  size_t chunk_count_ = 0;
+  size_t size_ = 0;
+  uint64_t hash_ = 0;
+};
+
+class r0dump_BufferPool final {
+ public:
+  explicit r0dump_BufferPool(size_t capacity_bytes = kR0dumpDefaultBufferPoolBytes,
+                             r0dump_HashFunction hash = r0dump_HashSegments,
+                             size_t max_code_item_bytes = kR0dumpMaxCodeItemBytesHardLimit);
+  ~r0dump_BufferPool();
+
+  r0dump_BufferPool(const r0dump_BufferPool&) = delete;
+  r0dump_BufferPool& operator=(const r0dump_BufferPool&) = delete;
+
+  std::unique_ptr<r0dump_OwnedCapture> r0dump_TryAcquire(const uint8_t* data, size_t size);
+  bool r0dump_TryPrepareCodeItem(const uint8_t* data,
+                                 size_t size,
+                                 r0dump_PreparedCapture* prepared);
+  bool r0dump_IsReady() const;
+  size_t r0dump_CapacityBytes() const;
+  size_t r0dump_MaxCodeItemBytes() const { return max_code_item_bytes_; }
+  size_t r0dump_ReservedBytes() const;
+  size_t r0dump_HighWaterBytes() const;
+
+ private:
+  std::shared_ptr<r0dump_BufferState> state_;
+  size_t max_code_item_bytes_;
+};
+
+enum class r0dump_CaptureKind : uint8_t {
+  kDexView = 1,
+  kBuffer = 2,
+  kDexData = 3,
+  kCodeItem = 4,
+  kMetadata = 5,
+};
+
+enum class r0dump_DexFormat : uint8_t {
+  kNotApplicable = 0,
+  kStandard = 1,
+  kCompact = 2,
+};
+
+enum class r0dump_RecordStatus : uint8_t {
+  kAccepted,
+  kDuplicate,
