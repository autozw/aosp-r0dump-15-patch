+TEST_F(r0dump_FileTest, WritesTruthfulSessionSnapshot) {
+  const int run_fd = r0dump_OpenRun();
+  ASSERT_GE(run_fd, 0);
+  r0dump_ProcessConfig config = {
+      .schema = 1u,
+      .enabled = true,
+      .run_id = "run",
+      .target_package = "bin.mt.plus",
+      .target_process = "bin.mt.plus",
+      .process_name = "bin.mt.plus",
+      .output_parent = output_parent_,
+      .capture_point_mask = 5u,
+      .walk_enabled = true,
+      .force_invoke_enabled = true,
+      .force_class = "example.Target",
+      .force_method = "materialize",
+      .force_method_descriptor = "()V",
+  };
+  ASSERT_TRUE(
+      r0dump_WriteSessionFile(
+          run_fd, config, 123u, 10001u, 456u, "fingerprint", "com.android.art/1", "OK", "complete")
