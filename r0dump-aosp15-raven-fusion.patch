+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+#include "r0dump/r0dump_log.h"
+
+#include <atomic>
+#include <mutex>
+#include <string>
+#include <thread>
+#include <vector>
+
+#include "gtest/gtest.h"
+
+namespace art HIDDEN {
+namespace {
+
+std::atomic<uint64_t> g_now_ns(0);
+std::vector<std::string>* g_lines = nullptr;
+std::mutex g_lines_lock;
+
+uint64_t r0dump_TestClock() { return g_now_ns.load(); }
+
+void r0dump_Collect(r0dump_LogLevel, std::string_view line) {
+  std::lock_guard<std::mutex> lock(g_lines_lock);
+  g_lines->emplace_back(line);
+}
+
+class r0dump_LogTest : public testing::Test {
+ protected:
+  void SetUp() override {
+    g_now_ns.store(0);
+    g_lines = &lines_;
+    r0dump_SetLogClockForTesting(r0dump_TestClock);
+    r0dump_SetLogSinkForTesting(r0dump_Collect);
+    r0dump_ResetLogStateForTesting();
+  }
+
+  void TearDown() override {
+    r0dump_SetLogSinkForTesting(nullptr);
+    r0dump_SetLogClockForTesting(nullptr);
+    r0dump_ResetLogStateForTesting();
+    g_lines = nullptr;
+  }
+
+  std::vector<std::string> lines_;
+};
+
+TEST_F(r0dump_LogTest, FormatsAndEscapesStructuredFields) {
+  r0dump_Log(r0dump_LogLevel::kInfo,
+             "capture staged",
+             {{"status", "ok"}, {"site", "dex=raw"}, {"path", "a b\\c\n"}});
+
+  ASSERT_EQ(1u, lines_.size());
+  EXPECT_EQ("event=capture\\sstaged status=ok site=dex\\=raw path=a\\sb\\\\c\\n", lines_[0]);
+}
+
+TEST_F(r0dump_LogTest, LimitsEachEventStatusAndSiteAndReportsSuppression) {
+  for (size_t i = 0; i != 12; ++i) {
+    r0dump_Log(r0dump_LogLevel::kInfo, "hook_seen", {{"status", "ok"}, {"site", "42"}});
+  }
+  EXPECT_EQ(10u, lines_.size());
+
+  g_now_ns.store(UINT64_C(1000000000));
+  r0dump_Log(r0dump_LogLevel::kInfo, "hook_seen", {{"status", "ok"}, {"site", "42"}});
+  ASSERT_EQ(12u, lines_.size());
+  EXPECT_EQ("event=hook_seen status=ok site=42 suppressed=2", lines_[10]);
+  EXPECT_EQ("event=hook_seen status=ok site=42", lines_[11]);
+}
+
+TEST_F(r0dump_LogTest, UsesIndependentRateBuckets) {
+  for (size_t i = 0; i != 11; ++i) {
+    r0dump_Log(r0dump_LogLevel::kInfo, "hook_seen", {{"status", "ok"}, {"site", "1"}});
+  }
+  r0dump_Log(r0dump_LogLevel::kInfo, "hook_seen", {{"status", "ok"}, {"site", "2"}});
+  EXPECT_EQ(11u, lines_.size());
+}
+
+TEST_F(r0dump_LogTest, SerializesConcurrentCalls) {
+  constexpr size_t kThreadCount = 4;
+  std::vector<std::thread> threads;
+  for (size_t i = 0; i != kThreadCount; ++i) {
+    threads.emplace_back([]() {
+      r0dump_Log(r0dump_LogLevel::kInfo, "walk_completed", {{"status", "ok"}, {"site", "1"}});
+    });
+  }
+  for (std::thread& thread : threads) {
+    thread.join();
+  }
+  EXPECT_EQ(kThreadCount, lines_.size());
+}
+
+}  // namespace
+}  // namespace art HIDDEN
diff --git a/art/runtime/r0dump/r0dump_memory.cc b/art/runtime/r0dump/r0dump_memory.cc
new file mode 100644
--- /dev/null
+++ b/art/runtime/r0dump/r0dump_memory.cc
@@ -0,0 +1,74 @@
+/* Copyright (C) 2026 The Android Open Source Project
+ * Licensed under the Apache License, Version 2.0.
+ */
+#include "r0dump_memory.h"
+#include <algorithm>
+#include <cerrno>
+#include <cinttypes>
+#include <cstdio>
+#include <new>
+#include <sys/uio.h>
+#include <unistd.h>
+namespace art {
+r0dump_MemoryCopy r0dump_CopyReadableMemory(const uint8_t* begin, size_t size, size_t max_bytes) {
+  r0dump_MemoryCopy result;
+  uintptr_t start = reinterpret_cast<uintptr_t>(begin);
+#if defined(__aarch64__)
+  start &= UINT64_C(0x00ffffffffffffff);
+#endif
+  if (begin == nullptr || size == 0 || size > max_bytes || size > UINTPTR_MAX - start) return result;
+  FILE* maps = fopen("/proc/self/maps", "re");
+  if (maps == nullptr) return result;
+  result.bytes.reset(new (std::nothrow) uint8_t[size]());
+  if (!result.bytes) { fclose(maps); return result; }
+  const long runtime_page_size = sysconf(_SC_PAGESIZE);
+  const size_t page_size = runtime_page_size > 0 ? static_cast<size_t>(runtime_page_size) : 4096u;
+  const uintptr_t end = start + size;
+  uintptr_t cursor = start;
+  auto hole = [&](uintptr_t address, size_t length) {
+    if (length == 0) return;
+    const size_t offset = address - start;
+    if (!result.holes.empty() &&
+        result.holes.back().offset + result.holes.back().length == offset) {
+      result.holes.back().length += length;
+    } else if (result.holes.size() < 128u) {
+      result.holes.push_back({offset, length});
+    } else {
+      result.holes_limited = true;
+    }
+  };
+  char line[768];
+  while (cursor < end && fgets(line, sizeof(line), maps) != nullptr) {
+    uintptr_t map_start = 0, map_end = 0;
+    char permissions[5] = {};
+    if (sscanf(line, "%" SCNxPTR "-%" SCNxPTR " %4s", &map_start, &map_end, permissions) != 3 ||
+        map_end <= cursor || map_start >= end || map_end <= map_start) continue;
+    const uintptr_t segment_start = std::max(cursor, map_start);
+    const uintptr_t segment_end = std::min(end, map_end);
+    hole(cursor, segment_start - cursor);
+    if (permissions[0] != 'r') {
+      hole(segment_start, segment_end - segment_start);
+      cursor = segment_end;
+      continue;
+    }
+    for (uintptr_t address = segment_start; address < segment_end;) {
+      const size_t chunk = std::min(static_cast<size_t>(segment_end - address),
+                                    page_size - static_cast<size_t>(address % page_size));
+      iovec local = {result.bytes.get() + (address - start), chunk};
+      iovec remote = {reinterpret_cast<void*>(address), chunk};
+      ssize_t read_bytes;
+      do { read_bytes = process_vm_readv(getpid(), &local, 1, &remote, 1, 0); }
+      while (read_bytes < 0 && errno == EINTR);
+      const size_t copied = read_bytes > 0 ? std::min(chunk, static_cast<size_t>(read_bytes)) : 0u;
+      result.copied_bytes += copied;
+      hole(address + copied, chunk - copied);
+      address += chunk;
+    }
+    cursor = segment_end;
+  }
+  hole(cursor, end - cursor);
+  fclose(maps);
+  result.complete = result.copied_bytes == size;
+  return result;
+}
+}  // namespace art
