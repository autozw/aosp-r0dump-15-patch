+#!/usr/bin/env python3
+
+from pathlib import Path
+
+
+ART = Path(__file__).resolve().parents[2]
+ROOT = ART.parent
+LIBCORE = ROOT / "libcore"
+
+
+def r0dump_read(path: Path) -> str:
+    return path.read_text(encoding="utf-8")
+
+
+def r0dump_between(source: str, begin: str, end: str) -> str:
+    start = source.index(begin)
+    finish = source.index(end, start + len(begin))
+    return source[start:finish]
+
+
+def r0dump_assert_no_route_side_effects(source: str) -> None:
+    for forbidden in (
+        "new Thread",
+        "Executor",
+        "Queue",
+        "PackageManager",
+        "getDeclaredField",
+        "FileOutputStream",
+        "open(",
+        "write(",
+        "fsync(",
+        "EnsureInitialized",
+        "ForceInvoke",
+    ):
+        assert forbidden not in source, forbidden
+
+
+def r0dump_check_runtime_bridge() -> None:
+    java = r0dump_read(
+        LIBCORE / "libart/src/main/java/dalvik/system/r0dump_Runtime.java"
+    )
+    configure = r0dump_between(
+        java,
+        "public static boolean r0dump_configure(",
+        "private static native boolean r0dump_configureNative(",
+    )
+    assert configure.index("r0dump_configureNative(") < configure.index(
+        "r0dump_capturePointMask = enabled ? capturePointMask : 0L;"
+    )
+    assert "private static volatile long r0dump_capturePointMask;" in java
+    loader = r0dump_between(
+        java,
+        "static void r0dump_CaptureRouteLoader(",
+        "static void r0dump_CaptureRouteCookie(",
+    )
+    assert loader.index("r0dump_IsCapturePointActive(point)") < loader.index(
+        "BaseDexClassLoader.r0dump_GetDexCookies"
+    )
+    assert "r0dump_CaptureRouteCookieNative(cookie, point, className);" in loader
+
+    native = r0dump_read(ART / "runtime/native/dalvik_system_r0dump_Runtime.cc")
+    mapping = r0dump_between(native, "bool r0dump_GetJavaRoute(", "bool r0dump_ToUint32(")
+    for point, site in (
+        ("kBdclPathConstructor", "BDCL.path.constructor"),
+        ("kBdclMemoryConstructor", "BDCL.memory.constructor"),
+        ("kBdclFindClassSuccess", "BDCL.findClass.success"),
+        ("kBdclAddDexPathReturn", "BDCL.addDexPath.return"),
+        ("kDexFileOpenFileReturn", "DexFile.open_file.return"),
+        ("kDexFileOpenMemoryReturn", "DexFile.open_memory.return"),
+        ("kDexFileBeforeDefine", "DexFile.before_define"),
+    ):
+        assert point in mapping
+        assert f'"{site}"' in mapping
+    route = r0dump_between(
+        native,
+        "static void r0dump_Runtime_r0dump_CaptureRouteCookieNative(",
+        "static void r0dump_Runtime_r0dump_CaptureExecutable(",
+    )
+    assert route.index("r0dump_GetJavaRoute") < route.index(
+        "r0dump_ConvertJavaArrayToDexFiles"
+    )
+    assert "r0dump_ObserveDexReference" in route
+    assert "r0dump_ObserveDexSource" in route
+    assert "r0dump_ObserveDex(" not in route
+    r0dump_assert_no_route_side_effects(route)
+    assert "r0dump_configureNative," in native
+    assert "r0dump_CaptureRouteCookieNative," in native
+    assert '"(Ljava/lang/Object;ILjava/lang/String;)V"' in native
+
+
+def r0dump_check_base_dex_class_loader() -> None:
+    source = r0dump_read(
+        LIBCORE / "dalvik/src/main/java/dalvik/system/BaseDexClassLoader.java"
+    )
+    path_constructor = r0dump_between(
+        source,
+        "public BaseDexClassLoader(String dexPath,\n            String librarySearchPath",
+        "public void reportClassLoaderChain()",
+    )
+    assert path_constructor.count("r0dump_POINT_BDCL_PATH_CONSTRUCTOR") == 1
+    assert path_constructor.index("this.pathList = new DexPathList") < path_constructor.index(
+        "r0dump_POINT_BDCL_PATH_CONSTRUCTOR"
+    ) < path_constructor.index("this.pathList.maybeRunBackgroundVerification(this);")
+
+    memory_constructor = r0dump_between(
+        source,
+        "public BaseDexClassLoader(ByteBuffer[] dexFiles",
+        "@Override\n    protected Class<?> findClass",
+    )
+    assert memory_constructor.index("initByteBufferDexPath(dexFiles)") < memory_constructor.index(
+        "r0dump_POINT_BDCL_MEMORY_CONSTRUCTOR"
+    ) < memory_constructor.index("maybeRunBackgroundVerification(this)")
+    hook = memory_constructor[
+        memory_constructor.index("r0dump_Runtime.r0dump_CaptureRouteLoader") :
+        memory_constructor.index("maybeRunBackgroundVerification(this)")
+    ]
+    for forbidden in ("dexFiles", "ByteBuffer", "array()", "position()", "limit()"):
+        assert forbidden not in hook
+
+    find_class = r0dump_between(
+        source,
+        "protected Class<?> findClass(String name)",
+        "public void addDexPath(@Nullable String dexPath)",
+    )
+    success = r0dump_between(find_class, "if (c != null) {", "// Now, check")
+    assert success.index("r0dump_POINT_BDCL_FIND_CLASS_SUCCESS") < success.index("return c;")
+    assert find_class[: find_class.index("Class c = pathList.findClass")].count(
+        "r0dump_POINT_BDCL_FIND_CLASS_SUCCESS"
+    ) == 0
+
+    add_path = r0dump_between(
+        source,
+        "public void addDexPath(String dexPath, boolean isTrusted)",
+        "public void addNativePath",
+    )
+    assert add_path.index("r0dump_GetDexElementCount()") < add_path.index(
+        "pathList.addDexPath"
+    ) < add_path.index("r0dump_CaptureRouteLoader")
+    assert "r0dump_firstElement" in add_path
+    assert "getParent(" not in add_path
+    r0dump_assert_no_route_side_effects(path_constructor)
+    r0dump_assert_no_route_side_effects(memory_constructor)
+    r0dump_assert_no_route_side_effects(success)
+    r0dump_assert_no_route_side_effects(add_path)
+
+
+def r0dump_check_dex_path_list() -> None:
+    source = r0dump_read(LIBCORE / "dalvik/src/main/java/dalvik/system/DexPathList.java")
+    helper = r0dump_between(
+        source, "Object[] r0dump_GetDexCookies()", "private List<File> getAllNativeLibraryDirectories"
+    )
+    assert "r0dump_GetDexCookies(int firstElement)" in helper
+    assert "r0dump_GetDexElementCount()" in helper
+    assert "for (int index = firstElement; index < dexElements.length; ++index)" in helper
+    assert "parent" not in helper
+    assert "getDeclaredField" not in helper
+
+
+def r0dump_check_dex_file() -> None:
+    source = r0dump_read(LIBCORE / "dalvik/src/main/java/dalvik/system/DexFile.java")
+    define = r0dump_between(
+        source,
+        "public Class loadClassBinaryName(",
+        "private static Class defineClass(",
+    )
+    assert define.index("r0dump_POINT_DEX_FILE_BEFORE_DEFINE") < define.index(
+        "return defineClass(name, loader, mCookie, this, suppressed);"
+    )
+    assert "name);" in define
+
+    open_file = r0dump_between(
+        source,
+        "private static Object openDexFile(",
+        "private static Object openInMemoryDexFiles(",
+    )
+    assert open_file.index("Object cookie = openDexFileNative(") < open_file.index(
+        "r0dump_POINT_DEX_FILE_OPEN_FILE_RETURN"
+    ) < open_file.index("return cookie;")
+
+    open_memory = r0dump_between(
+        source,
+        "private static Object openInMemoryDexFiles(",
+        "private static native Object openInMemoryDexFilesNative(",
+    )
+    assert open_memory.index("openInMemoryDexFilesNative(") < open_memory.index(
+        "r0dump_POINT_DEX_FILE_OPEN_MEMORY_RETURN"
+    ) < open_memory.index("return cookie;")
+    hook = open_memory[
+        open_memory.index("r0dump_Runtime.r0dump_CaptureRouteCookie") :
+        open_memory.index("return cookie;")
+    ]
+    for forbidden in ("bufs", "arrays", "starts", "ends", "ByteBuffer"):
+        assert forbidden not in hook
+    r0dump_assert_no_route_side_effects(define)
+    r0dump_assert_no_route_side_effects(open_file)
+    r0dump_assert_no_route_side_effects(hook)
+
+
+if __name__ == "__main__":
+    r0dump_check_runtime_bridge()
+    r0dump_check_base_dex_class_loader()
+    r0dump_check_dex_path_list()
+    r0dump_check_dex_file()
