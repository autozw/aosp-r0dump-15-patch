+  r0dump_AppendJsonNumber(&json,
+                          "pending_bytes",
+                          std::optional<size_t>(buffer.pending_bytes_high_water),
+                          &high_water_first);
+  r0dump_AppendJsonNumber(&json,
+                          "frozen_generations",
+                          std::optional<size_t>(buffer.frozen_generations_high_water),
+                          &high_water_first);
+  json.append("},\"walk_lanes\":{");
+  bool walk_first = true;
+  r0dump_AppendJsonNumber(&json,
+                          "cookie_class_list",
+                          std::optional<uint64_t>(writer.r0dump_WalkCookieRecords()),
+                          &walk_first);
+  r0dump_AppendJsonNumber(&json,
+                          "loaded_class_table",
+                          std::optional<uint64_t>(writer.r0dump_WalkLoadedTableRecords()),
+                          &walk_first);
+  r0dump_AppendJsonNumber(&json,
+                          "manifest_seed",
+                          std::optional<uint64_t>(writer.r0dump_WalkManifestRecords()),
+                          &walk_first);
+  json.append("},\"force_outcomes\":{");
+  bool force_first = true;
+  r0dump_AppendJsonNumber(&json,
+                          "attempt_records",
+                          std::optional<uint64_t>(writer.r0dump_ForceAttemptRecords()),
+                          &force_first);
+  r0dump_AppendJsonNumber(&json,
