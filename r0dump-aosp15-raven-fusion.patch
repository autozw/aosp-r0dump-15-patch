+  ASSERT_EQ(item["output_kind"].asString(), "reconstructed_standard") << report;
+  ASSERT_EQ(FindEntry(archive, prefix + item["output"].asString(), &entry), 0);
+  bytes.resize(entry.uncompressed_length);
+  ASSERT_EQ(ExtractToMemory(archive, &entry, bytes.data(), bytes.size()), 0);
+  uint8_t digest[SHA256_DIGEST_LENGTH];
+  SHA256(bytes.data(), bytes.size(), digest);
+  std::string actual;
+  for (uint8_t b : digest) {
+    actual += "0123456789abcdef"[b >> 4];
+    actual += "0123456789abcdef"[b & 15];
+  }
+  EXPECT_EQ(actual, kExpectedSha256);
+  CloseArchive(archive);
+}
+
