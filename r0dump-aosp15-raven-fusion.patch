+  }
+
+  enum r0dump_Status {
+    OK,
+    DISABLED,
+    NO_BASE_APK,
+    ASSET_COOKIE_MISSING,
+    XML_OPEN_FAILED,
+    MALFORMED_XML,
+    PACKAGE_MISSING,
