+  r0dump_AppendJsonNumber(&json, "artifacts", std::optional<size_t>(buffer.artifacts), &first);
+  r0dump_AppendJsonNumber(
+      &json, "admitted_bytes", std::optional<size_t>(buffer.admitted_bytes), &first);
+  json.append(",\"capture_points\":[");
+  for (size_t index = 0u; index != kR0dumpPointCount; ++index) {
+    if (index != 0u) {
+      json.push_back(',');
+    }
+    const r0dump_PointOutcomeCounters& outcome = buffer.point_outcomes[index];
+    const uint64_t recorded = outcome.accepted + outcome.dropped + outcome.duplicate;
+    json.push_back('{');
+    bool point_first = true;
