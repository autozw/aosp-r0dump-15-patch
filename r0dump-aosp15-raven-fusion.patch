@@ -0,0 +1,124 @@
+#!/usr/bin/env python3
+"""Checks the narrow F4 DefineClass hook contract."""
+
+from pathlib import Path
+
+
+SOURCE = Path(__file__).parents[1] / "class_linker.cc"
+
+
+def r0dump_function_body(source: str, signature: str, end_marker: str) -> str:
+    start = source.index(signature)
+    end = source.index(end_marker, start)
+    return source[start:end]
+
+
+def r0dump_main() -> None:
+    source = SOURCE.read_text()
+    body = r0dump_function_body(
+        source,
+        "ObjPtr<mirror::Class> ClassLinker::DefineClass(",
+        "uint32_t ClassLinker::SizeOfClassWithoutEmbeddedTables",
+    )
+    for point, site in (
+        ("kDefineClassEntry", '"DefineClass.entry"'),
+        ("kDefineClassSuccess", '"DefineClass.success"'),
+    ):
+        assert body.count(point) == 2, point
+        assert body.count(site) == 1, site
+        gate = f"if (UNLIKELY(r0dump_IsCapturePointActive(r0dump_Point::{point})))"
+        assert body.count(gate) == 1, gate
+        gate_offset = body.index(gate)
+        observe_offset = body.index("r0dump_ObserveDex", gate_offset)
+        assert gate_offset < observe_offset, point
+
+    success = body.index("kDefineClassSuccess")
+    assert body.index("jit::Jit::NewTypeLoadedIfUsingJit") < success
+    assert body.index("return sdc.Finish(h_new_class);", success) > success
+    assert "r0dump_Write" not in body
+    assert "open(" not in body
+
+    register_body = r0dump_function_body(
+        source,
+        "ObjPtr<mirror::DexCache> ClassLinker::RegisterDexFile(",
+        "bool ClassLinker::IsDexFileRegistered",
+    )
+    assert register_body.count("kRegisterDexFileReturn") == 2
+    assert register_body.index("r0dump_ObserveDex") < register_body.index("PaletteNotifyDexFileLoaded")
+
+    load_body = r0dump_function_body(
+        source,
+        "void ClassLinker::LoadClass(",
+        "void ClassLinker::AppendToBootClassPath",
+    )
+    for point, site in (
+        ("kLoadClassEntry", '"LoadClass.entry"'),
+        ("kLoadClassSuccess", '"LoadClass.success"'),
+    ):
+        assert load_body.count(point) == 2, point
+        assert load_body.count(site) == 1, site
+        assert load_body.count(f"if (UNLIKELY(r0dump_IsCapturePointActive(r0dump_Point::{point})))") == 1
+    assert load_body.index("kLoadClassEntry") < load_body.index("ClassAccessor")
+    assert load_body.index("kLoadClassSuccess") > load_body.index("AllowThreadSuspension")
+    # Android 15 has no LoadClassHelper: prepare both direct and virtual methods
+    # in LoadClass, then submit owned snapshots after its no-suspension scope.
+    assert load_body.count("kLoadMethodReady") == 2
+    assert "r0dump_prepared_code_items.reserve(" in load_body
+    assert load_body.count("LinkCode(art_method, class_def_method_index, &occi);\n          r0dump_prepare_method(art_method);") == 2
+    submit_methods = load_body.index("r0dump_SubmitPreparedCodeItem")
+    allow_methods = load_body.index("self->AllowThreadSuspension();")
+    assert allow_methods < submit_methods
+    assert "r0dump_Write" not in load_body
+    assert "open(" not in load_body
+
+    resolve_body = r0dump_function_body(
+        source,
+        "ArtMethod* ClassLinker::ResolveMethodWithoutInvokeType(",
+        "ArtField* ClassLinker::LookupResolvedField",
+    )
+    for point, site in (
+        ("kResolveMethodCacheHit", '"ResolveMethod.cache_hit"'),
+        ("kResolveMethodLookupSuccess", '"ResolveMethod.lookup_success"'),
+    ):
+        assert resolve_body.count(point) == 2, point
+        assert resolve_body.count(site) == 1, site
+    assert resolve_body.count("r0dump_ObserveResolveMethodMetadata") == 2
+    assert "r0dump_Write" not in resolve_body
+    assert "open(" not in resolve_body
+
+    verify_body = r0dump_function_body(
+        source,
+        "verifier::FailureKind ClassLinker::VerifyClass(",
+        "verifier::FailureKind ClassLinker::PerformClassVerification(",
+    )
+    assert verify_body.count("kVerifyClassComplete") == 2
+    assert verify_body.count('"VerifyClass.complete"') == 1
+    assert verify_body.count("r0dump_ObserveMetadata") == 1
+    assert verify_body.index("r0dump_ObserveMetadata") > verify_body.index("UpdateClassAfterVerification")
+    assert "r0dump_Write" not in verify_body
+    assert "open(" not in verify_body
+
+    init_body = r0dump_function_body(
+        source,
+        "bool ClassLinker::InitializeClass(",
+        "// We recursively run down the tree of interfaces.",
+    )
+    assert init_body.count("kClassInitBeforeClinit") == 2
+    assert init_body.count('"ClassInit.before_clinit"') == 1
+    prepare_clinit = init_body.index("r0dump_TryPrepareCodeItem")
+    invoke_clinit = init_body.index("clinit->Invoke")
+    allow_clinit = init_body.index("self->AllowThreadSuspension();", invoke_clinit)
+    submit_clinit = init_body.index("r0dump_SubmitPreparedCodeItem", invoke_clinit)
+    assert prepare_clinit < invoke_clinit < allow_clinit < submit_clinit
+    assert init_body.count("kClassInitSuccess") == 2
+    assert init_body.count('"ClassInit.success"') == 1
+    assert init_body.count("r0dump_ObserveMetadata") == 1
+    success = init_body.index("kClassInitSuccess")
+    assert init_body.index("callback->MakeVisible") < success
+    assert init_body.index("return success;", success) > success
+    assert "r0dump_Write" not in init_body
+    assert "open(" not in init_body
+
+
+if __name__ == "__main__":
+    r0dump_main()
