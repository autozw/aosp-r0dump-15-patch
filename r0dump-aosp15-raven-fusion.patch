+        "static int16_t GetReceiverRegisterForStringInit",
+    )
+    method = "ArtMethod *method = shadow_frame.GetMethod();"
+    observer = "r0dump_ObserveMethodCodeItem("
+    jit = "jit::Jit* jit = Runtime::Current()->GetJit();"
+    instrumentation = "instrumentation::Instrumentation* instrumentation"
+    assert body.count(observer) == 1
+    assert "r0dump_Point::kInterpreterExecuteEntry" in body
