+TEST_F(r0dump_FileTest, CreatesGroupAccessibleTreeAndWritesSegmentsAtomically) {
+  ASSERT_EQ(mkdir((output_parent_ + "/r0dump-fusion").c_str(), 0777), 0);
+  ASSERT_EQ(chmod((output_parent_ + "/r0dump-fusion").c_str(), 0777), 0);
+
+  const int run_fd = r0dump_OpenRun();
+  ASSERT_GE(run_fd, 0);
+  const r0dump_FileSegment first[] = {
+      {.data = reinterpret_cast<const uint8_t*>("ab"), .size = 2u},
+      {.data = reinterpret_cast<const uint8_t*>("cd"), .size = 2u},
+  };
+  ASSERT_TRUE(r0dump_WriteAtomicFileSegments(run_fd, "session.json", first, std::size(first)).ok);
+  ASSERT_TRUE(r0dump_WriteAtomicFile(run_fd, "session.json", "replacement", 11u).ok);
+
+  EXPECT_EQ(r0dump_ReadFileAt(run_fd, "session.json"), "replacement");
+  EXPECT_EQ(r0dump_CountTemporaryFiles(run_fd), 0u);
+  struct stat file_status = {};
+  struct stat run_status = {};
+  ASSERT_EQ(fstat(run_fd, &run_status), 0);
+  ASSERT_EQ(fstatat(run_fd, "session.json", &file_status, AT_SYMLINK_NOFOLLOW), 0);
+  EXPECT_EQ(file_status.st_mode & 0777, 0660);
+  EXPECT_EQ(file_status.st_gid, run_status.st_gid);
+  EXPECT_EQ(r0dump_Mode(output_parent_ + "/r0dump-fusion"), 0770);
+  EXPECT_EQ(r0dump_Mode(output_parent_ + "/r0dump-fusion/runs"), 0770);
+  EXPECT_EQ(r0dump_Mode(output_parent_ + "/r0dump-fusion/runs/run"), 0770);
+  EXPECT_EQ(r0dump_Mode(output_parent_ + "/r0dump-fusion/runs/run/process-123"), 0770);
